+def launch(command):
+    """Popen argv and executable. The x86 arm's [X86_DIRECT, "-0", argv0, program, *args] or
+    [X86_DIRECT, program, *args] runs program directly with the argv qemu-x86_64 would give it.
+    AArch64 programs, the corpus's own exec children included, reach qemu-aarch64 through the
+    binfmt_misc entry a64_binfmt() verified. Every other command is unchanged."""
+    if not command or command[0] != X86_DIRECT:
+        return command, None
+    if command[1] == "-0":
+        return [command[2], *command[4:]], command[3]
+    return list(command[1:]), command[1]
+
+
+def a64_binfmt(qemu):
+    """--host x86-native: the one enabled binfmt_misc entry that hands AArch64 ELF executables to
+    qemu with argv[0] kept (flag P), and no entry that would take an x86-64 ELF away from the kernel."""
+    def header(machine):  # ELF64, little-endian, version 1, System V, ET_EXEC, e_machine
+        return b"\x7fELF\x02\x01\x01" + bytes(9) + b"\x02\x00" + machine
+    found = []
+    for entry in sorted(Path("/proc/sys/fs/binfmt_misc").iterdir()):
+        if entry.name in ("register", "status"):
+            continue
+        text = entry.read_text()
+        lines = text.splitlines()
+        fields = dict(line.split(" ", 1) for line in lines[1:] if " " in line)
+        if lines[:1] != ["enabled"] or "magic" not in fields or fields.get("offset") != "0":
+            continue
+        magic = bytes.fromhex(fields["magic"])
+        mask = bytes.fromhex(fields.get("mask", "ff" * len(magic)))
+        def matches(image):
+            return all(a & m == b & m for a, b, m in zip(image, magic, mask))
+        if matches(header(b"\x3e\x00")):
+            raise Failure(f"binfmt_misc entry {entry.name} would run x86-64 programs through {fields.get('interpreter')}")
+        if matches(header(b"\xb7\x00")):
+            found.append((entry, text, fields))
+    if len(found) != 1:
+        raise Failure(f"--host x86-native needs exactly one enabled AArch64 binfmt_misc entry, found {len(found)}")
+    entry, text, fields = found[0]
+    if os.path.realpath(fields["interpreter"]) != os.path.realpath(qemu) or "P" not in fields.get("flags:", ""):
+        raise Failure(f"binfmt_misc {entry.name} must name {qemu} with flag P: {text!r}")
+    return {"binfmt_entry": str(entry), "binfmt": text}
+
