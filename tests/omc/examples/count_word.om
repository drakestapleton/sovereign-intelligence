note count_word: OM-2 `count A off n v`, a ulong, is how many of the n uchar elements of A from off
note equal v. Checked here against a byte-by-byte loop: every off 0..47 with lengths 0..40, the 16-byte
note chunk edges and the 4080-byte block edges, four values, over mixed bytes and over a run where every
note byte equals v; then in a local array, a text, a sized view, an unsized view, a part and an edit
note parameter, and with the destination also an input. Prints the number of cases and their counts.
om2
global g uchar 70000
global lens ulong 64
global nlen ulong 1
global cases ulong 1
global total ulong 1
global ob uchar 64
text tok "count_word ok cases "
text tsum " sum "
text tbad "count_word MISMATCH\n"
text tnl "\n"
text tt "a\nbb\n\nccc\n"

note naive: the same count over g, one byte at a time
fn naive o ulong n ulong v uchar to ulong
c = ulong 0
for i ulong n bound 70000
if eq get g add o i v
c = add c 1
end
end
ret c
end

note bad: report a mismatch and stop with exit 1
fn bad to void
k = write 1 tbad 0 len tbad
exit 1
end

note one: compare count with naive for g[o, o + n) and value v
fn one o ulong n ulong v uchar to void
a = count g o n v
b = naive o n v
if ne a b
bad
end
put cases 0 add get cases 0 1
put total 0 add get total 0 a
end

note addlen: append n to the length list
fn addlen n ulong to void
k = get nlen 0
put lens k n
put nlen 0 add k 1
end

note sweep: every off in [base, base + 48) with every listed length and four values
fn sweep base ulong to void
for j ulong 48
o = add base j
for q ulong get nlen 0 bound 64
n = get lens q
one o n 10
one o n 0
one o n 255
one o n 37
end
end
end

note emu: print v in decimal
fn emu v ulong to void
d = new uchar 20 0
x = v
k = ulong 0
going = true
while going bound 21
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
going = false
end
end
p = ulong 0
while gt k 0 bound 21
k = sub k 1
put ob p get d k
p = add p 1
end
w = write 1 ob 0 p
end

note views: count through a sized view, an unsized view and an edit parameter
fn cs a view uchar 16 o ulong n ulong v uchar to ulong
ret count a o n v
end

fn cv a view uchar * o ulong n ulong v uchar to ulong
ret count a o n v
end

fn ce a edit uchar * o ulong n ulong v uchar to ulong
put a 0 v
ret count a o n v
end

note forms: the other kinds of array, and a destination that is also an input
fn forms to void
loc = new uchar 16 7
put loc 3 10
put loc 9 10
put loc 15 10
if ne count loc 0 16 10 3
bad
end
if ne count loc 4 11 10 1
bad
end
if ne count loc 0 16 7 13
bad
end
if ne count tt 0 len tt 10 4
bad
end
if ne count tt 1 3 98 2
bad
end
if ne cs loc 0 16 10 3
bad
end
if ne cs loc 10 6 10 1
bad
end
if ne cv loc 0 16 10 3
bad
end
if ne cv part loc 3 7 0 7 10 2
bad
end
if ne cv part loc 4 0 0 0 10 0
bad
end
if ne ce loc 0 16 10 4
bad
end
o = ulong 2
o = count loc o 14 10
if ne o 3
bad
end
n = ulong 16
n = count loc 0 n 10
if ne n 4
bad
end
end

fn main to int
x = uint 12345
for i ulong 30000
x = add mul x 1103515245 12345
b = uchar and shr x 16 255
if lt b 64
b = uchar 10
end
put g i b
end
for i ulong 40000
put g add 30000 i 10
end
for i ulong 41
addlen i
end
addlen 63
addlen 64
addlen 65
addlen 255
addlen 256
addlen 257
addlen 1000
addlen 4079
addlen 4080
addlen 4081
addlen 4095
addlen 4096
addlen 4097
addlen 8160
addlen 8161
addlen 12000
sweep 0
sweep 30000
one 0 70000 10
one 0 70000 37
one 69999 1 10
one 70000 0 10
forms
k = write 1 tok 0 len tok
emu get cases 0
k = write 1 tsum 0 len tsum
emu get total 0
k = write 1 tnl 0 len tnl
ret 0
end
