em pweb
em prid
end

note pp_blob: the URL of path t at the commit of the facts
fn pp_blob t view uchar * to void
pp_purl
em ptree
emh fx_o fsha fx_n fsha
emb 47
em t
end

note pp_cmt: the URL of the commit of the facts
fn pp_cmt to void
pp_purl
em pcmts
emh fx_o fsha fx_n fsha
end

note pp_lb: a link to path u at the commit of the facts, with the label t
fn pp_lb u view uchar * t view uchar * to void
em pah
pp_blob u
em paq
em t
em paz
end

note pp_sha12: the first 12 characters of the commit sha
fn pp_sha12 to void
n = fx_n fsha
if gt n 12
n = 12
end
emh fx_o fsha n
end

note pp_dash: first - in src[s, e), or e
fn pp_dash s ulong e ulong to ulong
i = s
while lt i e bound 8388609
if eq get src i 45
ret i
end
i = add i 1
end
ret e
end

note pp_int: the 1 to 9 digits src[o, o+n) as a number; 0 for anything else
fn pp_int o ulong n ulong to ulong
if or eq n 0 gt n 9
ret 0
end
v = ulong 0
for i ulong n
c = get src add o i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end

note pp_date: facts.rs short_date: 2026-10-16T09:30:35Z or 2026-10-16 becomes 16 Oct 2026;
note anything else is appended unchanged (escaped)
fn pp_date o ulong n ulong to void
e = add o n
t = o
while lt t e bound 8388609
if eq get src t 84
break
end
t = add t 1
end
a = pp_dash o t
b = t
if lt a t
b = pp_dash add a 1 t
end
x = t
if lt b t
x = pp_dash add b 1 t
end
if or ge b t lt x t
emh o n
ret
end
m = pp_int add a 1 sub sub b a 1
d = pp_int add b 1 sub sub t b 1
if or or lt m 1 gt m 12 eq d 0
emh o n
ret
end
emu d
emb 32
k = mul sub m 1 3
emb get pmon k
emb get pmon add k 1
emb get pmon add k 2
emb 32
emh o sub a o
end

note pp_num: scalar fact k, which must be a decimal number
fn pp_num k ulong to void
v = fx_u k
emh fx_o k fx_n k
end

note pp_vcls: the pill class of the Spark receipt state (page.rs verdict_class)
fn pp_vcls to void
o = fx_o frstate
n = fx_n frstate
if eqt o n pvsucc
em pcok
ret
end
if eqt o n pvfailu
em pcbad
ret
end
if eqt o n pvpend
em pcwait
ret
end
em pcnone
end

note pp_blocked: does the receipt text start with BLOCKED and contain NOT_RUN
fn pp_blocked to bool
o = fx_o frtext
n = fx_n frtext
if lt n 7
ret false
end
if not eqt o 7 pvblk
ret false
end
e = add o n
ret lt find o e pvnrun e
end

note pp_vword: the word in the verdict pill (page.rs verdict_word), shown exactly as read
fn pp_vword to void
o = fx_o frstate
n = fx_n frstate
if eqt o n pvsucc
em pvwpass
ret
end
if eqt o n pvfailu
if pp_blocked
em pvblk
else
em pvwfail
end
ret
end
if eqt o n pvpend
em pvwrun
ret
end
em pvwnov
end

note pp_replnk: a link with the label t to the report named src[o, o+n) at the commit of the facts
fn pp_replnk o ulong n ulong t view uchar * to void
em pah
pp_blob pdocs
emh o n
em paq
em t
em paz
end

note pp_stword: the state words of stage i
fn pp_stword i ulong to void
o = fx_so i fsstate
n = fx_sn i fsstate
if eqt o n pwclosed
em ptclose
pp_date fx_so i fsclos fx_sn i fsclos
v = fx_so i fsverd
m = fx_sn i fsverd
if gt m 0
em ptgate
if eqt v m pvwpass
em pcok
else
em pcbad
end
em paq
emh v m
em ptstrz
end
ret
end
if eqt o n pwnext
em pwnext
ret
end
if eqt o n pwrepd
em ptrepb
ret
end
em ptplan
end

