note ledrow: row of LEDGER.tsv whose project is src[o, o+n), or the row count when there is none
fn ledrow o ulong n ulong to ulong
c = get tbn 2
for i ulong c bound 4096
if eqs o n f_o 2 i 0 f_n 2 i 0
ret i
end
end
ret c
end

note stkline: one project of STACK.tsv with its ledger numbers
fn stkline i ulong to void
o = f_o 1 i 0
n = f_n 1 i 0
em sr1
emh o n
em sr2
emh o n
em sr3
emh f_o 1 i 1 f_n 1 i 1
em sr4
emh f_o 1 i 3 f_n 1 i 3
em sr5
j = ledrow o n
if ge j get tbn 2
em snl
em sr5
em sr5
em sr7
ret
end
a = f_u 2 j 3
b = f_u 2 j 9
emc a
em sr5
emc b
em sr5
emp permil a b
em sr6
end

note repoline: one public project of repos.tsv
fn repoline i ulong to void
o = f_o 0 i 0
n = f_n 0 i 0
r = f_o 0 i 1
rn = f_n 0 i 1
em sp1
emh o n
em sp2
emh r rn
em sp3
emh o n
em sp4
if eqt f_o 0 i 3 f_n 0 i 3 score
em sp5
end
em sr3
emh r rn
em sp6
emh f_o 0 i 4 f_n 0 i 4
em sp7
emh r rn
em sp8
if gt rn 4
emh add r 4 sub rn 4
end
em sp9
h = f_n 0 i 2
if gt h 12
h = 12
end
emh f_o 0 i 2 h
em spa
end

note pgstack: /stack/
fn pgstack to void
pgopen 1
pghead 1
em s01
planes
em s02
emu get tbn 1
em s03
emc get tot 0
em s04
emc get tot 2
em s05
emc get tot 3
em s06
c = get tbn 1
for i ulong c bound 4096
stkline i
end
em s07
emu hub_nrepo
em s08
c = get tbn 0
for j ulong c bound 4096
repoline j
end
em s09
b = md_sec sq1
md_body b md_end b
em s10
pgclose
wfile wf1
end

note pgevid: /evidence/
fn pgevid to void
pgopen 2
pghead 2
em e01
evsec oq1
em e02
evsec oq2
em e03
b = md_sec eq3
md_body b md_end b
em e04
b = md_sec eq4
md_body b md_end b
em e05
b = md_sec eq5
md_body b md_end b
em e06
pgclose
wfile wf2
end

note pgproto: /protocol/, the sections of the protocol's own overview
fn pgproto to void
pgopen 4
pghead 4
pp_why
pp_modules
pp_longit
pp_jspace
pp_receipt
pp_statsec
pp_forget
pp_start
pp_source
pgclose
wfile wf4
end

note pgsub: one of the six protocol pages
fn pgsub q ulong to void
pgopen add q 10
pghead add q 10
if eq q 1
pp_quick
pgclose
wfile wp1
end
if eq q 2
pp_concept
pgclose
wfile wp2
end
if eq q 3
pp_adapter
pgclose
wfile wp3
end
if eq q 4
pp_conform
pgclose
wfile wp4
end
if eq q 5
pp_status
pgclose
wfile wp5
end
if eq q 6
pp_forge
pgclose
wfile wp6
end
end
