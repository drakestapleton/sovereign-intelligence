note wire/src/20-shape.om: the ipo1 shape table and the words of the form.
note
note A shape gives one word to one key sequence: an object whose keys, in JCS order, are
note exactly that sequence is written as the word followed by its values. The table is data:
note one line per shape, word TAB key TAB key ... LF, sorted by word. SPEC.md pins its sha256;
note "ipo shapes" prints it. It was built from tests/vectors.jsonl by the rule in SPEC.md
note (tests/census.om checks the rule). Changing one byte of it changes the form: a new
note table needs a new frame word, never ipo1.
note
note shinit refuses a table that breaks the rules (BADTABLE): a word is 1 to 8 bytes of a-z
note 0-9 starting with a letter, is not a reserved word, and words ascend strictly (so each is
note unique); a shape has at least 2 keys, printable ASCII, ascending strictly (JCS order); no
note two shapes have the same key sequence.

note the table: 15 shapes, one text per line, in word order (shload appends them in this order)
text sh00 "env\tdestination\tinterplane_version\tmessage_id\tparent_id\tpayload\tsource\ttimestamp\ttrace_id\n"
text sh01 "expo\tfloor\tinputs\n"
text sh02 "peer\tid\tkind\n"
text sh03 "prov\tcoercion\tdialect\tdialect_version\tmodel\tparser_version\traw_name\tsource_call_id\tsource_digest\tsource_turn\n"
text sh04 "prov2\tcoercion\tdialect\tdialect_version\texposure\tmodel\tparser_version\traw_name\tsource_call_id\tsource_digest\tsource_turn\n"
text sh05 "prov3\tdialect\tparser_version\n"
text sh06 "rcpt\tack_digest\tack_record_id\tgrant_digest\tgrant_id\tintent_digest\tintent_id\trequest_id\tstate\ttrace_id\n"
text sh07 "res\tdata\tdecision\terror\tkind\tprovenance\trequest_id\tstatus\n"
text sh08 "rprov\tcapability\tcontent_kind\tduration_ms\truntime\ttrust\ttrusted\n"
text sh09 "tool\tname\tnamespace\n"
text sh10 "treq\targuments\tkind\tprovenance\trequest_id\ttool\n"
text sh11 "treq2\targuments\textensions\tkind\tprovenance\trequest_id\ttool\n"
text sh12 "wfile\tcontent\tpath\n"
text sh13 "wrote\tbytes_written\tpath\n"
text sh14 "wrote2\tbytes_written\tpath\treceipt\n"

note the words every frame may use besides shape words; none of them is ever a bare string
text rmagic "ipo1"
text rnil "nil"
text ryes "yes"
text rno "no"
text robj "obj"
text rarr "arr"
text rend "end"

note shape s: word at shw (shwn bytes), shc keys from index shk in sko/skn (pool offset, length)
global shw ulong 256
global shwn ulong 256
global shk ulong 256
global shc ulong 256
global sko ulong 4096
global skn ulong 4096
note shn: shapes; skc: keys of all shapes
global shn ulong 1
global skc ulong 1

note shput: append one table text to the pool
fn shput t view uchar * to void
n = len t
for i ulong n
spb get t i
end
end

note shload: the table, in word order
fn shload to void
shput sh00
shput sh01
shput sh02
shput sh03
shput sh04
shput sh05
shput sh06
shput sh07
shput sh08
shput sh09
shput sh10
shput sh11
shput sh12
shput sh13
shput sh14
end

note isresw: is the pool slice one of the seven fixed words
fn isresw o ulong n ulong to bool
if or lt n 2 gt n 4
ret false
end
if seqt o n rmagic
ret true
end
if seqt o n rnil
ret true
end
if seqt o n ryes
ret true
end
if seqt o n rno
ret true
end
if seqt o n robj
ret true
end
if seqt o n rarr
ret true
end
ret seqt o n rend
end

note shfld: the end of the table field that starts at p: the position of its TAB or LF.
note Every byte of a field is printable ASCII.
fn shfld p ulong e ulong to ulong
q = p
while lt q e bound 65536
c = get sp q
if or eq c 9 eq c 10
ret q
end
if or lt c 32 gt c 126
fail EBADTAB q
end
q = add q 1
end
fail EBADTAB q
ret q
end

note shwok: the pool slice must be a legal shape word
fn shwok o ulong n ulong to void
if or eq n 0 gt n 8
fail EBADTAB o
end
c = get sp o
if or lt c 97 gt c 122
fail EBADTAB o
end
i = ulong 1
while lt i n bound 8
c = get sp add o i
lc = and ge c 97 le c 122
dg = and ge c 48 le c 57
if not or lc dg
fail EBADTAB add o i
end
i = add i 1
end
if isresw o n
fail EBADTAB o
end
end

note skcmp: table keys i and j compared (scmp)
fn skcmp i ulong j ulong to ulong
io = get sko i
il = get skn i
jo = get sko j
jl = get skn j
ret scmp io il jo jl
end

note shkeys: the keys of shape s, whose first key field starts at f; returns the position
note after the line's LF
fn shkeys s ulong f ulong e ulong to ulong
k = get skc 0
put shk s k
c = ulong 0
p = f
while true bound 4096
q = shfld p e
if ge k 4096
fail EBADTAB p
end
put sko k p
put skn k sub q p
if gt c 0
if ne skcmp sub k 1 k 0
fail EBADTAB p
end
end
k = add k 1
c = add c 1
p = add q 1
if eq get sp q 10
break
end
end
if lt c 2
fail EBADTAB f
end
put shc s c
put skc 0 k
ret p
end

note shline: shape s from the table line at p; returns the position after its LF
fn shline s ulong p ulong e ulong to ulong
if ge s 256
fail EBADTAB p
end
q = shfld p e
n = sub q p
shwok p n
if ne get sp q 9
fail EBADTAB q
end
if gt s 0
t = sub s 1
if ne scmp get shw t get shwn t p n 0
fail EBADTAB p
end
end
put shw s p
put shwn s n
ret shkeys s add q 1 e
end

note shsame: do shapes s and t have the same key sequence
fn shsame s ulong t ulong to bool
c = get shc s
if ne c get shc t
ret false
end
a = get shk s
b = get shk t
i = ulong 0
while lt i c bound 4096
if ne skcmp add a i add b i 1
ret false
end
i = add i 1
end
ret true
end

note shinit: put the table at the start of the pool, index it and check it
fn shinit to void
put spn 0 0
put skc 0 0
shload
e = get spn 0
put sp0 0 e
p = ulong 0
s = ulong 0
while lt p e bound 65536
p = shline s p e
s = add s 1
end
put shn 0 s
t = ulong 1
while lt t s bound 256
u = ulong 0
while lt u t bound 256
if shsame u t
fail EBADTAB get shw t
end
u = add u 1
end
t = add t 1
end
end

note shmatch: are the keys of object a exactly the keys of shape s (the counts are equal)
fn shmatch s ulong a ulong to bool
k = get shk s
c = get na a
while ne c 0 bound BND
ko = get sko k
kl = get skn k
co = get nko c
cl = get nkn c
if ne scmp ko kl co cl 1
ret false
end
k = add k 1
c = get nx c
end
ret true
end

note shfind: the shape of object a: its index plus 1, or 0 when no shape has its key sequence
fn shfind a ulong to ulong
cnt = get nb a
n = get shn 0
s = ulong 0
while lt s n bound 256
if eq get shc s cnt
if shmatch s a
ret add s 1
end
end
s = add s 1
end
ret 0
end

note shwfind: the shape whose word is the pool slice: its index plus 1, or 0
fn shwfind o ulong n ulong to ulong
if gt n 8
ret 0
end
c = get shn 0
s = ulong 0
while lt s c bound 256
so = get shw s
sn = get shwn s
if eq scmp so sn o n 1
ret add s 1
end
s = add s 1
end
ret 0
end

note barec: may c follow the first byte of a bare string: a-z 0-9 _ . -
fn barec c uchar to bool
if and ge c 97 le c 122
ret true
end
if and ge c 48 le c 57
ret true
end
if or eq c 95 or eq c 46 eq c 45
ret true
end
ret false
end

note barepat: does the pool slice match [a-z_][a-z0-9_.-]{0,63}
fn barepat o ulong n ulong to bool
if or eq n 0 gt n 64
ret false
end
c = get sp o
f = or eq c 95 and ge c 97 le c 122
if not f
ret false
end
i = ulong 1
while lt i n bound 64
if not barec get sp add o i
ret false
end
i = add i 1
end
ret true
end

note isbare: is the pool slice a string that is written without quotes: the pattern, and
note not one of the fixed words, and not a shape word
fn isbare o ulong n ulong to bool
if not barepat o n
ret false
end
if isresw o n
ret false
end
if ne shwfind o n 0
ret false
end
ret true
end
