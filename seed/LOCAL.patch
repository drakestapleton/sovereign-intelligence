+e3 2332033024 p ulong get nm_reg i ro
+end
+m = alloc
+emit or or 2852127712 m shl rn 16
+emit or 1308691456 shl v 5
+s = alloc
+emit or 3531603968 s
+k = alloc
+emit or 4043325471 shl m 5
+emit 1409286659
+emit or 3544513552 shl m 5
+emit 4043570719
+emit 1409286217
+emit 3531612144
+emit 1862329345
+emit or 1289711618 shl p 5
+emit 1847626818
+emit 1847755809
+emit or or 3506454528 m shl m 5
+emit 4043310608
+emit 1426063201
+emit 1848653858
+emit 235027536
+emit or or 2333081600 s shl s 5
+emit 402653168
+emit or 3019899104 m
+emit or 234961920 k
+emit or 943723536 shl p 5
+emit or 1795162655 shl k 16
+emit or or or 2592084992 s shl s 5 shl s 16
+emit or or 4043310080 m shl m 5
+emit 1426063233
