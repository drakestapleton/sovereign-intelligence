note subst: copy the file IN to OUT with exactly one occurrence of the text FROM replaced by TO.
note usage: subst IN OUT FROM TO   (FROM and TO are taken byte for byte: no escapes, no patterns)
note exit: 0 written; 1 FROM occurs zero times or more than once, and no output file is written;
note       2 bad arguments (wrong count, empty or over-long text, IN and OUT the same path);
note       3 IN unreadable or 262144 bytes or longer; 4 OUT or the report could not be written.
note Occurrences are counted at every byte offset, so overlapping matches count separately.
note Used to build the NL8 mutants from nl8.om (PREREG.md section 8). No other tool edits a source.
note SIB the input file, SPI and SPO the two paths, SFR and STO the two texts, SM first match offset.
global SIB uchar 262144
global SPI uchar 1024
global SPO uchar 1024
global SFR uchar 4096
global STO uchar 4096
global SM ulong 1
global SOB uchar 96
global SOL ulong 1
text STX "SUBST OK offset=| bytes_out=|SUBST REFUSED matches="

note ---- report line, collected in SOB
fn sob c uchar to void
n = get SOL 0
if ge n 96
exit 4
end
put SOB n c
put SOL 0 add n 1
end
fn snum n ulong to void
if ge n 10
snum div n 10
end
sob uchar add rem n 10 48
end
note stx: segment n of STX; segments are separated by the byte 124
fn stx n ulong to void
s = ulong 0
for i ulong len STX
c = get STX i
if eq c 124
s = add s 1
else
if eq s n
sob c
end
end
end
end
note sflush: bound: every pass writes at least one of at most 96 bytes
fn sflush to void
p = ulong 0
e = get SOL 0
while lt p e bound 96
k = write 1 SOB p sub e p
if le k 0
exit 4
end
p = add p ulong k
end
put SOL 0 0
end

note ---- input
note sload: all of IN into SIB; the byte count, or -1 (unreadable, or it fills the buffer)
note bound: every pass reads at least one of at most 262144 bytes
fn sload n ulong to long
fd = fopen SPI 0 n 0 0
if lt fd 0
ret -1
end
got = ulong 0
er = ulong 0
while lt got 262144 bound 262145
k = read int fd SIB got sub 262144 got
if lt k 0
er = 1
break
end
if eq k 0
break
end
got = add got ulong k
end
c = fclose int fd
if eq er 1
ret -1
end
if ge got 262144
ret -1
end
ret long got
end
note smatch: 1 when SIB[p..p+n) equals SFR[0..n). The caller keeps p+n inside the file.
fn smatch p ulong n ulong to ulong
for i ulong n
if ne get SIB add p i get SFR i
ret 0
end
end
ret 1
end
note scount: the number of offsets where FROM occurs; the first one goes to SM
note bound: p runs over at most 262144 offsets
fn scount got ulong n ulong to ulong
c = ulong 0
if gt n got
ret 0
end
lim = sub got n
p = ulong 0
while le p lim bound 262144
if eq smatch p n 1
if eq c 0
put SM 0 p
end
c = add c 1
end
p = add p 1
end
ret c
end
note samepath: 1 when the two path texts are byte-equal
fn samepath a ulong b ulong to ulong
if ne a b
ret 0
end
for i ulong a
if ne get SPI i get SPO i
ret 0
end
end
ret 1
end

note ---- output
note swrsib: SIB[a..e) to fd; bound: every pass writes at least one of at most 262144 bytes
fn swrsib fd int a ulong e ulong to void
p = a
while lt p e bound 262144
k = write fd SIB p sub e p
if le k 0
exit 4
end
p = add p ulong k
end
end
note swrsto: STO[0..n) to fd; bound: every pass writes at least one of at most 4096 bytes
fn swrsto fd int n ulong to void
p = ulong 0
while lt p n bound 4096
k = write fd STO p sub n p
if le k 0
exit 4
end
p = add p ulong k
end
end
note 577 is O_WRONLY or O_CREAT or O_TRUNC (1, 64, 512 on Linux AArch64 and x86-64), 420 is mode 0644.
note The output file is opened only after exactly one match was counted.
fn main to int
if ne argcnt 5
ret 2
end
n1 = argread 1 SPI 0 1024
n2 = argread 2 SPO 0 1024
n3 = argread 3 SFR 0 4096
n4 = argread 4 STO 0 4096
if or le n1 0 le n2 0
ret 2
end
if or le n3 0 lt n4 0
ret 2
end
if eq samepath ulong n1 ulong n2 1
ret 2
end
got = sload ulong n1
if lt got 0
ret 3
end
c = scount ulong got ulong n3
if ne c 1
stx 2
snum c
sob 10
sflush
ret 1
end
p = get SM 0
fd = fopen SPO 0 ulong n2 577 420
if lt fd 0
ret 4
end
swrsib int fd 0 p
swrsto int fd ulong n4
swrsib int fd add p ulong n3 ulong got
k = fclose int fd
if lt k 0
ret 4
end
stx 0
snum p
stx 1
snum add sub ulong got ulong n3 ulong n4
sob 10
sflush
ret 0
end
