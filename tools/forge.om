cauth c
em is5
emts get cts c
em is6
emr get cid c 40
em is7
th = objt j kthread
cs = objt th kcomms
e = arr1 objt th ktimel
while ne e 0 bound 16777216
if isstr e
comm objr cs add e 1 sub sub sskip e e 2
end
e = anext e
end
em ir1
emr get cid c 40
em ir2
emr get prid pj get prn pj
em ir3
emr get cid c 40
em ir4
pgf
padd tslash
paddz pj
padd fissue
paddh get cid c
padd fhtml
wpage
end

note comm: one comment: who, when, the body as last edited
fn comm cm ulong to void
if eq cm 0
ret
end
em cm1
emnid objt cm kauthor
em cm2
emts jnum objt arr1 objt cm kedits ktime
em cm3
ems objt cm kbody
em cm4
end

note ---- a patch page


fn apage c ulong to void
j = get cjs c
pj = get cpj c
pgh tup0
ems objt j ktitle
pgm tup1
em is1
pname pj
em is2
ems objt j ktitle
labels objt j klabels
em is3
badge c
em pa4
cauth c
em is5
emts get cts c
em is6
emr get cid c 40
em is7
pgate j
em pg1
vbadge
if ne get gv 0 0
em pg2
emts get gvt 0
em pg3
jdec get gvb 0
emline
em tcodee
end
em pg4
merges objt j kmerges
revs j
em prc
emr get cid c 40
em prd
emr get cid c 40
em pre
pgf
padd tslash
paddz pj
padd fpatch
paddh get cid c
padd fhtml
