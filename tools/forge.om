note merges: the commit each merge recorded
fn merges o ulong to void
m = obj1 o
while ne m 0 bound 16777216
em pm1
ems objt mval m kcommit
em pm2
m = mnext m
end
end

note revs: the revisions of the patch at j, in the order of its timeline (which also names its
note comments, reviews and merges: only the ids that are revisions are taken)
fn revs j ulong to void
rs = objt j krevs
e = arr1 objt j ktimel
k = ulong 0
while ne e 0 bound 16777216
if isstr e
r = objr rs add e 1 sub sub sskip e e 2
if ne r 0
k = add k 1
revn r k
end
end
e = anext e
end
end

note emline: sb up to its first newline, escaped
fn emline to void
n = get sbn 0
for i ulong n bound 4194304
c = get sb i
if eq c 10
ret
end
esc1 c
end
end

note revn: revision k of a patch: when, base, head, its description and discussion
fn revn r ulong k ulong to void
if eq r 0
ret
end
em pr1
emu k
em pr2
emts jnum objt r ktime
em pr3
ems objt r kbase
em pr4
ems objt r koid
em pr6
dl = alast objt r kdesc
jdec objt dl kbody
if gt get sbn 0 0
em cm1
emnid objt objt r kauthor kid
em cm2
emts jnum objt dl ktime
em cm3
ems objt dl kbody
em cm4
end
d = objt r kdisc
cs = objt d kcomms
e = arr1 objt d ktimel
while ne e 0 bound 16777216
if isstr e
comm objr cs add e 1 sub sub sskip e e 2
end
e = anext e
end
end

note ---------------------------------------------------------------------------------------------

fn main to int
if ne argcnt 5
w = write 2 tusage 0 len tusage
ret 2
end
n = argread 3 db 0 16
if ne n 10
diem tday
end
z = dparse
if or eq z 0 lt z 13
diem tday
end
put dnow 0 z
put dfst 0 sub z 13
loadf
facts
m = get nc 0
for c ulong m bound 16384
if eq get ckd c 1
istate c
else
pstate c
end
end
ledger
n2 = get np 0
for i ulong n2 bound 1024
put tot 0 add get tot 0 get p14 i
put tot 1 add get tot 1 get pal i
end
order
opath
index
stats
for j ulong n2 bound 1024
pdir j
ppage j
end
for c2 ulong m bound 16384
if eq get ckd c2 1
ipage c2
else
apage c2
end
end
ret 0
end
