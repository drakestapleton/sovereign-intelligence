note hub/src/20-style.om: the one stylesheet, written out as /style.css.
note
note Plumbline look: a night-sky header and hero that never change with the theme, an amber line
note that runs through every plane, paper below it in light mode and ink in dark mode. System fonts
note only, no imports, no url(): the browser asks nobody but the site itself.

text c01 ":root{color-scheme:light dark;--bg:#f6f4ee;--surface:#fffefb;--ink:#14161b;--mute:#566070;--line:#e2ddd1;--line2:#cbc4b3;--accent:#9a5600;--beam:#f2a93b;--ok:#17663a;--bad:#a32b22;--wait:#7a5a00;--code:#eeeae0;--night:#0b0d12;--night2:#12151c;--nightline:#232834;--nightink:#f2f0ea;--nightmute:#a3aab8;--sans:ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;--wrap:72rem}\n"
text c02 "@media (prefers-color-scheme:dark){:root{--bg:#0b0d12;--surface:#12151c;--ink:#eceae4;--mute:#9aa1ae;--line:#222733;--line2:#323a49;--accent:#f2a93b;--ok:#7bd89a;--bad:#ff8a80;--wait:#f0c674;--code:#171b24}}\n"
text c03 "*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:5rem}\nbody{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.6 var(--sans);text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}\na{color:var(--accent);text-underline-offset:.18em;text-decoration-thickness:.06em}\na:hover{text-decoration-thickness:.12em}\n:focus-visible{outline:2px solid var(--beam);outline-offset:3px;border-radius:4px}\nh1,h2,h3,h4{text-wrap:balance}\np,li{text-wrap:pretty}\n"
text c04 ".skip{position:absolute;left:-999px;top:0;background:var(--beam);color:#14161b;padding:.5rem .9rem;z-index:20;border-radius:0 0 8px 0;font-weight:600}\n.skip:focus{left:0}\ncode,pre,kbd,.mono{font-family:var(--mono);font-size:.9em}\ncode{background:var(--code);padding:.08em .34em;border-radius:5px;overflow-wrap:anywhere}\npre{background:var(--code);border:1px solid var(--line);border-radius:12px;padding:1rem 1.15rem;overflow-x:auto;line-height:1.5;margin:1.1rem 0}\npre code{background:none;padding:0;overflow-wrap:normal;font-size:.88rem}\n.wrap{max-width:var(--wrap);margin:0 auto;padding:0 1.25rem}\n"
text c05 ".top{position:sticky;top:0;z-index:10;background:#0b0d12e6;backdrop-filter:blur(12px) saturate(1.2);-webkit-backdrop-filter:blur(12px) saturate(1.2);border-bottom:1px solid var(--nightline);color:var(--nightink)}\n.top .wrap{display:flex;align-items:center;gap:1.25rem;min-height:3.6rem}\n.brand{display:flex;align-items:center;gap:.6rem;color:var(--nightink);text-decoration:none;font-weight:700;letter-spacing:.22em;font-size:.92rem;flex:none}\n.brand svg{width:1.45rem;height:1.45rem;flex:none}\n.nav{display:flex;gap:.15rem;margin-left:auto;overflow-x:auto;scrollbar-width:none}\n.nav a{color:var(--nightmute);text-decoration:none;padding:.42rem .7rem;border-radius:8px;font-size:.92rem;font-weight:500;white-space:nowrap}\n.nav a:hover{color:var(--nightink);background:#ffffff14}\n.nav a[aria-current=page]{color:#14161b;background:var(--beam)}\n"
text c06 ".hero{background:radial-gradient(60rem 30rem at 80% 6%,#f2a93b26,transparent 60%),radial-gradient(44rem 28rem at 4% 100%,#4b7bff1c,transparent 60%),linear-gradient(180deg,var(--night),var(--night2));color:var(--nightink);border-bottom:1px solid var(--nightline);overflow:hidden;position:relative}\n.hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(#ffffff09 1px,transparent 1px),linear-gradient(90deg,#ffffff09 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(70% 70% at 50% 40%,#000,transparent);mask-image:radial-gradient(70% 70% at 50% 40%,#000,transparent);pointer-events:none}\nmain>section.hero{padding:0;border-bottom:1px solid var(--nightline)}\n.hero>.wrap.statw{display:block;padding-top:0;padding-bottom:0}\n.hero>.wrap{position:relative;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:2rem;align-items:center;padding-top:4.2rem;padding-bottom:3.6rem}\n"
text c07 ".kicker{font:600 .74rem/1.4 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--beam);display:flex;gap:.8rem;flex-wrap:wrap;margin:0 0 1.4rem}\n.kicker span+span::before{content:'/';margin-right:.8rem;color:#ffffff40}\nh1.word{font-size:clamp(2.5rem,6.3vw,5.1rem);line-height:.94;letter-spacing:.05em;font-weight:800;margin:0}\n.tag{font-size:clamp(1.5rem,3vw,2.3rem);line-height:1.15;font-weight:700;margin:1.3rem 0 0;letter-spacing:-.01em}\n.tag em{font-style:normal;color:var(--beam);display:block}\n.lede{color:var(--nightmute);max-width:36rem;margin:1.2rem 0 0;font-size:1.08rem}\n.lede strong{color:var(--nightink);font-weight:600}\n"
text c08 ".cta,.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:2rem}\n.btn,.button{display:inline-flex;align-items:center;gap:.5rem;padding:.72rem 1.1rem;border-radius:10px;border:1px solid var(--line2);color:var(--ink);text-decoration:none;font-weight:600;font-size:.96rem;background:var(--surface);transition:transform .15s,background .15s,border-color .15s}\n.btn:hover,.button:hover{border-color:var(--beam);transform:translateY(-1px)}\n.hero .btn,.phead .btn{border-color:#ffffff2e;color:var(--nightink);background:#ffffff0c}\n.hero .btn:hover,.phead .btn:hover{background:#ffffff18;border-color:#ffffff60}\n.btn.primary,.button.primary,.hero .btn.primary{background:var(--beam);border-color:var(--beam);color:#14161b}\n.btn.primary:hover,.button.primary:hover,.hero .btn.primary:hover{background:#ffbd57;border-color:#ffbd57}\n"
text c09 ".art{width:100%;height:auto;max-width:35rem;justify-self:end;display:block}\n.art .pl{fill:#ffffff12;stroke:#ffffff5c;stroke-width:1}\n.art .gr{stroke:#ffffff1f;stroke-width:1;fill:none}\n.art .ln{stroke:var(--beam);stroke-width:2.5;stroke-linecap:round;fill:none;filter:drop-shadow(0 0 6px #f2a93bcc);stroke-dasharray:700;stroke-dashoffset:700;animation:drop 1.9s .25s cubic-bezier(.6,.05,.2,1) forwards}\n.art .nd{fill:var(--beam);filter:drop-shadow(0 0 8px #f2a93b);opacity:0;animation:lit .5s forwards}\n.art .halo{fill:none;stroke:var(--beam);stroke-width:1.2;opacity:0;transform-box:fill-box;transform-origin:center;animation:halo 3.4s ease-out infinite}\n.art .lb{font:600 13px var(--mono);letter-spacing:.2em;fill:#f2f0ea}\n.art .ls{font:400 12px var(--mono);fill:#a3aab8}\n.art .bob{fill:var(--beam);filter:drop-shadow(0 0 10px #f2a93b)}\n.art .cap{fill:#f2f0ea}\n.art .tl{fill:var(--beam);opacity:0;animation:tile .6s forwards}\n.art .jk{fill:none;stroke:#ffffff66;stroke-width:1;transform-box:fill-box;transform-origin:center;animation:drift 11s ease-in-out infinite alternate}\n@keyframes tile{to{opacity:.5}}\n@keyframes drift{from{transform:translate(0,0) rotate(0deg)}to{transform:translate(9px,-14px) rotate(70deg)}}\n@keyframes drop{to{stroke-dashoffset:0}}\n@keyframes lit{to{opacity:1}}\n@keyframes halo{0%{opacity:.75;transform:scale(1)}100%{opacity:0;transform:scale(3)}}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.art .ln{animation:none;stroke-dashoffset:0}.art .nd{animation:none;opacity:1}.art .halo{animation:none}.art .tl{animation:none;opacity:.5}.art .jk{animation:none}.btn,.button{transition:none}}\n"
text c10 ".stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--nightline);position:relative}\n.stat{padding:1.4rem 1.25rem 1.6rem;border-left:1px solid var(--nightline)}\n.stat:first-child{border-left:0;padding-left:0}\n.stat b{display:block;font:700 clamp(1.45rem,3vw,2.2rem)/1.1 var(--mono);letter-spacing:-.02em;color:var(--nightink)}\n.stat span{display:block;color:var(--nightmute);font-size:.88rem;margin-top:.45rem}\n.stat small{display:block;color:#ffffff99;font:400 .72rem var(--mono);margin-top:.4rem}\n"
text c11 ".sec,main>section,.legacy>section{padding:4.6rem 0;border-bottom:1px solid var(--line)}\nmain>section>h2,.sec h2,.legacy>section>h2,.h2{font-size:clamp(1.7rem,3.2vw,2.5rem);line-height:1.12;letter-spacing:-.02em;margin:0 0 .8rem;font-weight:750}\nmain h3{font-size:1.2rem;line-height:1.25;margin:2rem 0 .6rem}\n.eyebrow{font:600 .74rem/1.2 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:0 0 .9rem}\n.sub,.section-lede{color:var(--mute);max-width:46rem;margin:0 0 2.2rem;font-size:1.08rem}\n.prose{max-width:46rem}\n.prose p{margin:0 0 1rem}\n.fine{color:var(--mute);font-size:.92rem}\n.legacy>section{max-width:var(--wrap);margin:0 auto;padding-left:1.25rem;padding-right:1.25rem}\nblockquote,.quote{font-size:clamp(1.25rem,2.3vw,1.75rem);line-height:1.3;font-weight:650;letter-spacing:-.01em;border-left:3px solid var(--beam);padding:.2rem 0 .2rem 1.2rem;margin:0 0 2rem;max-width:46rem}\n.legacy>section>p,.legacy>section>ul,.legacy>section>ol,.legacy>section>pre{max-width:52rem}\n.legacy>section>h2:not(:first-child){margin-top:2.8rem}\nstrong.ok{color:var(--ok)}\nstrong.bad{color:var(--bad)}\n.dot{color:var(--line2);margin:0 .35rem}\n"
text c12 ".planes{position:relative;display:grid;gap:1.1rem;padding-left:2.6rem}\n.planes::before{content:'';position:absolute;left:.72rem;top:0;bottom:0;width:2px;background:var(--beam);box-shadow:0 0 12px #f2a93b99;border-radius:2px}\n.plane{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:1.4rem 1.5rem 1.5rem;display:grid;grid-template-columns:minmax(0,16rem) minmax(0,1fr);gap:1.6rem;box-shadow:0 1px 0 #0000000a,0 14px 34px -22px #00000040}\n.plane::before{content:'';position:absolute;left:-2.32rem;top:1.75rem;width:.9rem;height:.9rem;border-radius:50%;background:var(--beam);box-shadow:0 0 0 4px var(--bg),0 0 14px #f2a93b}\n.plane h3{margin:0;font:700 .78rem var(--mono);letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}\n.plane .pt{font-size:1.35rem;font-weight:700;letter-spacing:-.01em;margin:.4rem 0 .5rem;line-height:1.2}\n.plane p{margin:0;color:var(--mute);font-size:.97rem}\n.plane .tot{font:500 .8rem var(--mono);color:var(--mute);margin-top:.9rem}\n.subs{display:grid;gap:1.05rem;align-content:start}\n.subrow{display:grid;grid-template-columns:6.4rem minmax(0,1fr) 5.6rem;gap:.5rem .9rem;align-items:center}\n.subrow .nm{font:600 .88rem var(--mono)}\n.bar{height:.5rem;background:var(--code);border-radius:99px;overflow:hidden}\n.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--beam),#ffd089);border-radius:99px;min-width:3px}\n.subrow .pc{font:500 .8rem var(--mono);color:var(--mute);white-space:nowrap;text-align:right}\n.chips{display:flex;flex-wrap:wrap;gap:.35rem;grid-column:1/-1}\n.chip{font:500 .77rem var(--mono);padding:.16rem .52rem;border:1px solid var(--line);border-radius:99px;color:var(--ink);text-decoration:none;background:var(--bg)}\n.chip:hover{border-color:var(--beam)}\n.plane.thru{background:linear-gradient(135deg,#f2a93b1f,transparent 55%),var(--surface);border-color:#f2a93b80}\n"
text c13 ".steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;counter-reset:s;margin:0;padding:0;list-style:none}\n.step{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:1.3rem 1.3rem 1.4rem;position:relative}\n.step::before{counter-increment:s;content:'0' counter(s);font:700 .8rem var(--mono);color:var(--accent);letter-spacing:.1em}\n.step h3{margin:.5rem 0 .4rem;font-size:1.1rem}\n.step p{margin:0;color:var(--mute);font-size:.95rem}\n.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:2.5rem;align-items:start}\n.junk h2{font-size:clamp(2rem,4.4vw,3.3rem);line-height:1.04;letter-spacing:-.025em;margin:0}\n.junk .big2{font-size:1.18rem;line-height:1.55;margin:0 0 1.2rem}\n.junk p{color:var(--mute);margin:0 0 1rem}\n.junk p.big2{color:var(--ink)}\n.wreck{list-style:none;margin:1.6rem 0 0;padding:0;display:grid;gap:.55rem}\n.wreck li{display:flex;gap:.8rem;align-items:baseline;font-weight:600}\n.wreck li::before{content:'';flex:none;width:.6rem;height:.6rem;border:1.5px solid var(--accent);transform:rotate(22deg) translateY(.05rem)}\n.note{display:flex;gap:.9rem;align-items:baseline;flex-wrap:wrap;margin:2rem 0 0;padding:1rem 1.2rem;border:1px dashed var(--line2);border-radius:12px;color:var(--mute);font-size:.97rem}\n.note span.t{flex:1 1 24rem}\nmain h3.cap{font:600 .76rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--mute);margin:0 0 .6rem}\npre.wrapc{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.82rem;line-height:1.55;margin-top:0}\npre.wrapc code{overflow-wrap:anywhere;font-size:inherit}\n.prose .pill{margin-right:.4rem}\n"
text c14 ".proofs{display:grid;gap:.8rem;margin:0;padding:0;list-style:none}\n.proof{display:grid;grid-template-columns:11rem minmax(0,1fr);gap:1.2rem;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.25rem}\n.proof p{margin:0}\n.proof .rc{color:var(--mute);font-size:.9rem;margin-top:.5rem}\n.proof .when{display:block;color:var(--mute);font:400 .78rem var(--mono);margin-top:.5rem}\n.pill{display:inline-block;font:700 .7rem var(--mono);letter-spacing:.08em;padding:.24rem .58rem;border-radius:99px;border:1px solid currentColor;white-space:nowrap;text-transform:uppercase}\n.pill.ok{color:var(--ok)}\n.pill.bad{color:var(--bad)}\n.pill.wait{color:var(--wait)}\n.pill.none{color:var(--mute)}\n.pill.chip{color:#14161b;background:var(--beam);border-color:var(--beam)}\n.pill.live{color:var(--ok);background:color-mix(in srgb,var(--ok) 12%,transparent)}\n"
text c15 ".chain{display:grid;gap:.6rem;margin:0;padding:0;list-style:none}\n.rung{display:grid;grid-template-columns:5.5rem minmax(0,1fr) 7.5rem 9rem;gap:1rem;align-items:center;font:500 .88rem var(--mono)}\n.rung .bar{height:.7rem}\n.rung .sz{text-align:right}\n.rung .sh{color:var(--mute);font-size:.78rem;text-align:right}\n.get{background:var(--night);color:var(--nightink);border-radius:18px;padding:2rem 2.2rem;border:1px solid var(--nightline);position:relative;overflow:hidden}\n.get::after{content:'';position:absolute;right:-6rem;top:-6rem;width:18rem;height:18rem;background:radial-gradient(circle,#f2a93b38,transparent 65%);pointer-events:none}\n.get h2{margin:0 0 .5rem;color:var(--nightink)}\n.get p{color:var(--nightmute);margin:.4rem 0 0;max-width:42rem}\n.get pre{background:#00000066;border-color:var(--nightline);color:#ffd089;font-size:1rem;margin:1.2rem 0 .4rem}\n.get a{color:var(--beam)}\n"
text c16 ".scroll{overflow-x:auto}\n.tbl{width:100%;border-collapse:collapse;font-size:.93rem}\n.tbl th{text-align:left;font:600 .72rem var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--mute);padding:.6rem .7rem;border-bottom:1px solid var(--line2);background:var(--bg)}\n.tbl td{padding:.7rem;border-bottom:1px solid var(--line);vertical-align:top}\n.tbl td.n{font-weight:650;white-space:nowrap}\n.tbl td.r{text-align:right;font-family:var(--mono);font-size:.86rem;white-space:nowrap}\n.tbl th.r{text-align:right}\n.tbl .rid{display:block;font:400 .76rem var(--mono);color:var(--mute);overflow-wrap:anywhere;margin-top:.2rem}\n.tbl tr:target td{background:color-mix(in srgb,var(--beam) 16%,transparent)}\n.core{font:700 .64rem var(--mono);letter-spacing:.1em;color:#14161b;background:var(--beam);border-radius:4px;padding:.08rem .34rem;margin-left:.4rem;vertical-align:middle}\n"
text c17 ".phead{background:radial-gradient(50rem 22rem at 85% 0,#f2a93b20,transparent 60%),linear-gradient(180deg,var(--night),var(--night2));color:var(--nightink);border-bottom:1px solid var(--nightline);padding:3.4rem 0 2.6rem}\n.phead h1{font-size:clamp(2rem,4.6vw,3.4rem);line-height:1.05;letter-spacing:-.02em;margin:0}\n.phead p{color:var(--nightmute);max-width:46rem;margin:1rem 0 0;font-size:1.1rem}\n.phead .kicker{margin-bottom:1rem}\n.subnav,.docs-nav{display:flex;gap:.3rem;flex-wrap:wrap;margin-top:1.6rem}\n.subnav a,.docs-nav a{color:var(--nightmute);text-decoration:none;padding:.36rem .7rem;border-radius:99px;border:1px solid var(--nightline);font-size:.88rem}\n.subnav a:hover,.docs-nav a:hover{color:var(--nightink);border-color:#ffffff55}\n.subnav a[aria-current=page],.docs-nav a[aria-current=page]{color:#14161b;background:var(--beam);border-color:var(--beam)}\n"
text c18 ".modules{list-style:none;margin:1.5rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(17rem,1fr));gap:1rem}\n.modules li{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.2rem}\n.modules h3{margin:0 0 .3rem;font-size:1.05rem}\n.modules .question{color:var(--accent);font-weight:600;margin:0 0 .4rem}\n.modules p{margin:0 0 .4rem;font-size:.95rem;color:var(--mute)}\n.modules .spec{font:400 .8rem var(--mono)}\n.receipt-grid,.status-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1rem;margin:1.5rem 0}\n.cell{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.2rem}\n.big{display:block;font:700 clamp(1.5rem,3vw,2.1rem)/1.1 var(--mono);letter-spacing:-.02em}\n.label{display:block;color:var(--mute);font-size:.88rem;margin-top:.4rem}\n.verdict{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;margin:1rem 0}\n.verdict-text{color:var(--mute)}\n"
text c19 ".stage-list{list-style:none;margin:1rem 0;padding:0;display:grid;gap:.5rem}\n.stage{display:grid;grid-template-columns:4rem 9rem minmax(0,1fr) auto;gap:1rem;align-items:baseline;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:.8rem 1rem}\n.stage .version{font:700 .95rem var(--mono)}\n.stage .layer{font-weight:650}\n.stage .goal{color:var(--mute);font-size:.95rem}\n.stage .state{font:600 .76rem var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}\n.stage.next .state{color:var(--accent)}\n.stage.planned{opacity:.75}\n.counts{list-style:none;margin:1rem 0;padding:0;display:flex;gap:.6rem;flex-wrap:wrap}\n.counts li{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:.3rem .8rem;font-size:.9rem;max-width:100%;overflow-wrap:anywhere}\n.counts .pill{white-space:normal;text-align:left;border-radius:10px}\n.report-list{list-style:none;margin:1rem 0;padding:0;display:grid;gap:.7rem}\n.report-list li{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:.9rem 1.1rem}\n.report-list .headline{display:block;color:var(--mute);margin-top:.3rem;font-size:.95rem}\n.docs-main ol,.prose ol,.prose ul{padding-left:1.3rem}\n.docs-main li,.prose li{margin:.35rem 0}\n"
text c20 ".foot{background:var(--night);color:var(--nightmute);padding:3.5rem 0 2.6rem;font-size:.93rem}\n.foot a{color:var(--nightink)}\n.foot .cols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:2rem}\n.foot h4{font:600 .72rem var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--beam);margin:0 0 .8rem}\n.foot ul{list-style:none;margin:0;padding:0;display:grid;gap:.4rem}\n.foot p{margin:0 0 .7rem;max-width:26rem}\n.foot .hdae{margin-top:2.4rem;font-size:.86rem}\n.foot .hdae p{max-width:58rem}\n.foot .fine{border-top:1px solid var(--nightline);margin-top:2.4rem;padding-top:1.3rem;display:flex;gap:.6rem 1.4rem;flex-wrap:wrap;justify-content:space-between;font:400 .76rem var(--mono);color:#ffffff8c}\n"
text c21 "@media (max-width:60rem){.hero>.wrap{grid-template-columns:1fr;padding-top:3rem}.art{justify-self:center;max-width:28rem}.plane{grid-template-columns:1fr;gap:1.1rem}.steps{grid-template-columns:repeat(2,minmax(0,1fr))}.two{grid-template-columns:1fr;gap:1.5rem}.foot .cols{grid-template-columns:1fr 1fr}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.stat:nth-child(3){border-left:0;padding-left:0}.stat:nth-child(n+3){border-top:1px solid var(--nightline)}}\n@media (max-width:40rem){body{font-size:1rem}.sec,main>section{padding:3.2rem 0}.brand span{display:none}.proof{grid-template-columns:1fr;gap:.6rem}.rung{grid-template-columns:4.4rem minmax(0,1fr) 5.6rem}.rung .sh{display:none}.steps{grid-template-columns:1fr}.stage{grid-template-columns:3.2rem minmax(0,1fr)}.stage .goal,.stage .state{grid-column:2}.subrow{grid-template-columns:5.4rem minmax(0,1fr) 4.4rem}.planes{padding-left:1.9rem}.planes::before{left:.4rem}.plane::before{left:-1.94rem}.get{padding:1.5rem 1.2rem}.foot .cols{grid-template-columns:1fr}}\n"

