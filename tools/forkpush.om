om2
note tools/forkpush.om: the Radicle fork-push script generator, in pure seeded Omega.
note
note My personal GitHub account holds branches of stack work that never reached the projects'
note Radicle homes. stack/FORKS.tsv lists every one of them and where it goes. This program turns
note that manifest into the POSIX sh script that pushes the Radicle-bound ones home, so the script
note is generated from data, never written by hand. Build with the seed-born compiler:
note   omc < tools/forkpush.om > forkpush && chmod +x forkpush
note   { printf 'target x86linux\n'; cat tools/forkpush.om; } | omc-x86 > forkpush   (native x86-64)
note Run:
note   forkpush FORKS OUT
note   FORKS  read: stack/FORKS.tsv. The header line is exactly
note            github TAB branch TAB head TAB commits TAB date TAB action TAB dest
note          then one branch per line, exactly 7 TAB-separated fields:
note            github   owner/name, both parts of letters, digits, . _ -
note            branch   letters, digits, . _ / -; not starting with - or /, not ending with /,
note                     no .. and no //
note            head     40 lowercase hex digits
note            commits  1 to 20 decimal digits
note            date     YYYY-MM-DD, digits
note            action   radicle (dest is the project's RID, rad:z then letters and digits),
note                     private (dest is -) or si (dest is the path in this repository, the
note                     same characters and rules as a branch)
note          A (github, branch) pair appears once. At most 4096 rows and 4 MiB.
note   OUT    written: the script. For every radicle row it fetches the branch from
note          https://github.com/<github> into a Radicle working copy of the project, checks the
note          fetched commit is the manifest head, and pushes it to Radicle as fork/<branch>.
note          private and si rows become comment lines only. Every value is single-quoted in the
note          script; validation guarantees none holds a quote.
note Exit 0 when OUT is written; 2 for the wrong number of arguments; 1 for any refusal, with one
note stderr line "forkpush: ..." and OUT not opened (the script is built in memory and written
note once, at the end). The output depends only on the input bytes: no clock, no environment.

note the manifest bytes and the script bytes
global inp uchar 4194304
global inn ulong 1
global ob uchar 4194304
global obn ulong 1
note the path named by the current argument
global pb uchar 4096
global pbn ulong 1
note rows, 16 cells each: offset and length of the 7 fields (cells 0..13), then the offset and
note length of the whole line (14, 15)
global row ulong 65536
global nrow ulong 1
note the action of each row: 1 radicle, 2 private, 3 si
global act ulong 4096
note rows per action: radicle, private, si
global cnt ulong 3

text tpre "forkpush: "
text tnl "\n"
text tusage "usage: forkpush FORKS OUT\n"
text targ "cannot read a command-line argument"
text topen "cannot open "
text tread "cannot read "
text tbig "manifest over the 4 MiB buffer: "
text twrite "cannot write "
text toverf "script over the 4 MiB buffer"
text thdr "github\tbranch\thead\tcommits\tdate\taction\tdest"
text tbhdr "header line is not github TAB branch TAB head TAB commits TAB date TAB action TAB dest: "
text tcols "row needs exactly 7 TAB-separated fields: "
text tmany "more than 4096 rows at: "
text tbgh "bad github owner/name: "
text tbbr "bad branch: "
text tbhd "head is not 40 lowercase hex digits: "
text tbcm "commits is not 1 to 20 decimal digits: "
text tbdt "date is not YYYY-MM-DD: "
text tbac "action is not radicle, private or si: "
text tbrid "radicle dest is not a RID (rad:z then letters and digits): "
text tbpr "private dest is not -: "
text tbsi "bad si dest path: "
text tdup "duplicate github and branch: "
text aradi "radicle"
text apriv "private"
text asi "si"
text tradz "rad:z"
text tdash "-"
text q1 "fp '"
text q2 "' '"
text q3 "'\n"
text c1 "# private, kept off Radicle: "
text c2 "# in this repository at "
text c3 ": "
text sp " "
text m1 "# Manifest: "
text m2 " to push to Radicle, "
text m3 " kept private, "
text m4 " in this repository.\n\n"

note the script, paragraph by paragraph
text h0 "#!/bin/sh\n# fork-push: push the fork-only branches of my personal GitHub forks to their Radicle projects.\n# Generated by tools/forkpush.om from stack/FORKS.tsv; do not edit by hand.\n#\n# For every stack/FORKS.tsv row whose action is radicle, it fetches the branch from\n# https://github.com/<owner>/<repo> into a Radicle working copy of the project, checks that the\n# fetched commit is the head the manifest names, and only then pushes it to Radicle as\n# fork/<branch>. Rows kept private and rows already in this repository are listed below as\n# comments and are never fetched or pushed.\n#\n# Needs git, and rad authenticated as the project's delegate with its node running\n# (rad auth, rad node start). It refuses to run as root.\n#   FP_DIR=path  the one directory it creates and works in (default ./fork-push); each project\n#                is cloned there once, into a directory named after its RID without rad:\n# Exit status: 0 every branch OK, 2 a fetched commit is not the manifest head,\n# 3 a clone, fetch or push failed (3 wins over 2).\n"
text h1 "set -eu\numask 022\n\nFP_DIR=\"${FP_DIR:-./fork-push}\"\nfp_say() { printf '%s\\n' \"$*\"; }\nfp_die() { printf 'fork-push: %s\\n' \"$*\" >&2; exit 1; }\n\nif [ \"$(id -u)\" = \"0\" ]; then fp_die \"refusing to run as root; run it as your own user\"; fi\ncommand -v git >/dev/null 2>&1 || fp_die \"git is required: https://git-scm.com\"\ncommand -v rad >/dev/null 2>&1 || fp_die \"rad is required: https://radicle.xyz\"\nmkdir -p -- \"$FP_DIR\"\ncd -- \"$FP_DIR\"\nfp_ok=0\nfp_bad=0\nfp_fail=0\n\n"
text h2 "fp() {\n  fp_d=\"${1#rad:}\"\n  if [ ! -d \"$fp_d\" ]; then\n    if ! rad clone \"$1\" \"$fp_d\" </dev/null; then\n      fp_say \"FAILED    $1 rad clone\"\n      fp_fail=$((fp_fail + 1))\n      rm -rf -- \"./$fp_d\"\n      return 0\n    fi\n  fi\n  if ! git -C \"$fp_d\" fetch --no-tags --quiet \"https://github.com/$2\" \"+refs/heads/$3:refs/heads/fork/$3\" </dev/null; then\n    fp_say \"FAILED    $1 fork/$3 fetch from https://github.com/$2\"\n    fp_fail=$((fp_fail + 1))\n    return 0\n  fi\n  fp_got=\"$(git -C \"$fp_d\" rev-parse \"refs/heads/fork/$3\" 2>/dev/null || true)\"\n  if [ \"$fp_got\" != \"$4\" ]; then\n    fp_say \"MISMATCH  $1 fork/$3 manifest $4, fetched ${fp_got:-none}\"\n    fp_bad=$((fp_bad + 1))\n    return 0\n  fi\n  if git -C \"$fp_d\" push --quiet rad \"refs/heads/fork/$3:refs/heads/fork/$3\" </dev/null; then\n    fp_say \"OK        $1 fork/$3 $4\"\n    fp_ok=$((fp_ok + 1))\n  else\n    fp_say \"FAILED    $1 fork/$3 push\"\n    fp_fail=$((fp_fail + 1))\n  fi\n}\n\n"
text h3 "\nfp_say \"\"\nfp_say \"Done in $(pwd): $fp_ok OK, $fp_bad MISMATCH, $fp_fail FAILED.\"\nif [ \"$fp_fail\" -gt 0 ]; then exit 3; fi\nif [ \"$fp_bad\" -gt 0 ]; then exit 2; fi\nexit 0\n"

note die: report m and up to 200 bytes of inp from o on stderr, then exit 1
fn die m view uchar * o ulong n ulong to void
k = n
if gt k 200
k = 200
end
w = write 2 tpre 0 len tpre
w = write 2 m 0 len m
if gt k 0
w = write 2 inp o k
end
w = write 2 tnl 0 len tnl
exit 1
end

note dief: report m and the current path on stderr, then exit 1
fn dief m view uchar * to void
w = write 2 tpre 0 len tpre
w = write 2 m 0 len m
w = write 2 pb 0 get pbn 0
w = write 2 tnl 0 len tnl
exit 1
end

note setpath: copy command-line argument ai into pb
fn setpath ai ulong to void
n = argread ai pb 0 4096
if le n 0
die targ 0 0
end
put pbn 0 ulong n
end

note load: read the file named by argument ai into inp
fn load ai ulong to void
setpath ai
fd = fopen pb 0 get pbn 0 0 0
if lt fd 0
dief topen
end
p = ulong 0
note every pass but the last reads at least one byte of the 4 MiB buffer
while lt p 4194304 bound 4194305
k = read int fd inp p sub 4194304 p
if lt k 0
dief tread
end
if eq k 0
break
end
p = add p ulong k
end
c = fclose int fd
if ge p 4194304
dief tbig
end
put inn 0 p
end

note wout: write ob to the file named by argument ai (created or truncated, mode 0644)
fn wout ai ulong to void
setpath ai
fd = fopen pb 0 get pbn 0 577 420
if lt fd 0
dief topen
end
n = get obn 0
p = ulong 0
while lt p n bound 4194305
k = write int fd ob p sub n p
if le k 0
dief twrite
end
p = add p ulong k
end
c = fclose int fd
if ne c 0
dief twrite
end
end

note em: append a text to ob
fn em t view uchar * to void
p = get obn 0
n = len t
if gt n sub 4194304 p
die toverf 0 0
end
for i ulong n bound 4194304
put ob add p i get t i
end
put obn 0 add p n
end

note emi: append n bytes of inp from o to ob
fn emi o ulong n ulong to void
p = get obn 0
if gt n sub 4194304 p
die toverf 0 0
end
for i ulong n bound 4194304
put ob add p i get inp add o i
end
put obn 0 add p n
end

note emb: append one byte to ob
fn emb c uchar to void
p = get obn 0
if ge p 4194304
die toverf 0 0
end
put ob p c
put obn 0 add p 1
end

note emu: append v in decimal to ob
fn emu v ulong to void
d = new uchar 20 0
x = v
put d 0 uchar add rem x 10 48
k = ulong 1
x = div x 10
while gt x 0 bound 20
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
end
while gt k 0 bound 20
k = sub k 1
emb get d k
end
end

note eqx: do the n bytes of inp at o equal the text t
fn eqx o ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 4194304
if ne get inp add o i get t i
ret false
end
end
ret true
end

note eqs: are two slices of inp equal
fn eqs a ulong an ulong b ulong bn ulong to bool
if ne an bn
ret false
end
for i ulong an bound 4194304
if ne get inp add a i get inp add b i
ret false
end
end
ret true
end

note eol: the end of the line that starts at p (its newline, or e)
fn eol p ulong e ulong to ulong
q = p
while lt q e bound 4194305
if eq get inp q 10
ret q
end
q = add q 1
end
ret e
end

fn isaln c uchar to bool
ret or or and ge c 48 le c 57 and ge c 65 le c 90 and ge c 97 le c 122
end

note isnm: a letter, a digit, or one of . _ -
fn isnm c uchar to bool
if isaln c
ret true
end
ret or or eq c 46 eq c 95 eq c 45
end

fn isdig c uchar to bool
ret and ge c 48 le c 57
end

fn ishex c uchar to bool
ret or and ge c 48 le c 57 and ge c 97 le c 102
end

note vgh: is inp[o, o+n) owner/name, both parts non-empty letters, digits, . _ -
fn vgh o ulong n ulong to bool
sl = ulong 0
ns = ulong 0
for i ulong n bound 4194304
c = get inp add o i
if eq c 47
ns = add ns 1
sl = i
else
if not isnm c
ret false
end
end
end
if ne ns 1
ret false
end
ret and gt sl 0 lt add sl 1 n
end

note vpath: is inp[o, o+n) a branch or path: letters, digits, . _ / -, not starting with - or
note /, not ending with /, no .. and no //
fn vpath o ulong n ulong to bool
if eq n 0
ret false
end
c0 = get inp o
if or eq c0 45 eq c0 47
ret false
end
if eq get inp add o sub n 1 47
ret false
end
pr = uchar 0
for i ulong n bound 4194304
c = get inp add o i
if not or isnm c eq c 47
ret false
end
if and eq c 46 eq pr 46
ret false
end
if and eq c 47 eq pr 47
ret false
end
pr = c
end
ret true
end

note vhead: is inp[o, o+n) 40 lowercase hex digits
fn vhead o ulong n ulong to bool
if ne n 40
ret false
end
for i ulong 40
if not ishex get inp add o i
ret false
end
end
ret true
end

note vnum: is inp[o, o+n) 1 to 20 decimal digits
fn vnum o ulong n ulong to bool
if or eq n 0 gt n 20
ret false
end
for i ulong n bound 20
if not isdig get inp add o i
ret false
end
end
ret true
end

note vdate: is inp[o, o+n) YYYY-MM-DD in digits
fn vdate o ulong n ulong to bool
if ne n 10
ret false
end
for i ulong 10
c = get inp add o i
if or eq i 4 eq i 7
if ne c 45
ret false
end
else
if not isdig c
ret false
end
end
end
ret true
end

note vrid: is inp[o, o+n) rad:z then at least one letter or digit
fn vrid o ulong n ulong to bool
if le n 5
ret false
end
if not eqx o 5 tradz
ret false
end
for i ulong sub n 5 bound 4194304
if not isaln get inp add add o 5 i
ret false
end
end
ret true
end

note fo / fl: offset and length of field k of row r
fn fo r ulong k ulong to ulong
ret get row add mul r 16 mul k 2
end

fn fl r ulong k ulong to ulong
ret get row add add mul r 16 mul k 2 1
end

note lineo / linel: offset and length of row r's whole line
fn lineo r ulong to ulong
ret get row add mul r 16 14
end

fn linel r ulong to ulong
ret get row add mul r 16 15
end

note bad: refuse row r with message m when ok is false
fn bad ok bool m view uchar * r ulong to void
if not ok
die m lineo r linel r
end
end

note split: store the 7 TAB-separated fields of the line [p, q) as row r
fn split p ulong q ulong r ulong to void
b = mul r 16
put row add b 14 p
put row add b 15 sub q p
k = ulong 0
s = p
t = p
while lt t q bound 4194305
if eq get inp t 9
if ge k 6
die tcols p sub q p
end
put row add b mul k 2 s
put row add add b mul k 2 1 sub t s
k = add k 1
s = add t 1
end
t = add t 1
end
if ne k 6
die tcols p sub q p
end
put row add b 12 s
put row add b 13 sub q s
end

note actof: the action of row r: 1 radicle, 2 private, 3 si; 0 for anything else
fn actof r ulong to ulong
o = fo r 5
n = fl r 5
if eqx o n aradi
ret 1
end
if eqx o n apriv
ret 2
end
if eqx o n asi
ret 3
end
ret 0
end

note vdest: check row r's dest against its action a
fn vdest r ulong a ulong to void
o = fo r 6
n = fl r 6
if eq a 1
bad vrid o n tbrid r
end
if eq a 2
bad eqx o n tdash tbpr r
end
if eq a 3
bad vpath o n tbsi r
end
end

note vrow: check every field of row r, record its action, and refuse a repeated pair
fn vrow r ulong to void
bad vgh fo r 0 fl r 0 tbgh r
bad vpath fo r 1 fl r 1 tbbr r
bad vhead fo r 2 fl r 2 tbhd r
bad vnum fo r 3 fl r 3 tbcm r
bad vdate fo r 4 fl r 4 tbdt r
a = actof r
bad gt a 0 tbac r
vdest r a
put act r a
j = sub a 1
put cnt j add get cnt j 1
for i ulong r bound 4096
if eqs fo i 0 fl i 0 fo r 0 fl r 0
bad not eqs fo i 1 fl i 1 fo r 1 fl r 1 tdup r
end
end
end

note parse: check the header, then split and check every row
fn parse to void
e = get inn 0
q = eol 0 e
if not eqx 0 q thdr
die tbhdr 0 q
end
p = add q 1
r = ulong 0
note every pass consumes at least one byte of the manifest
while lt p e bound 4194305
q = eol p e
if ge r 4096
die tmany p sub q p
end
split p q r
vrow r
r = add r 1
p = add q 1
end
put nrow 0 r
end

note emf: append field k of row r
fn emf r ulong k ulong to void
emi fo r k fl r k
end

note emrow: append row r's line of the script
fn emrow r ulong to void
a = get act r
if eq a 1
em q1
emf r 6
em q2
emf r 0
em q2
emf r 1
em q2
emf r 2
em q3
ret
end
if eq a 2
em c1
else
em c2
emf r 6
em c3
end
emf r 0
em sp
emf r 1
em tnl
end

fn main to int
if ne argcnt 3
w = write 2 tusage 0 len tusage
ret 2
end
load 1
parse
em h0
em m1
emu get cnt 0
em m2
emu get cnt 1
em m3
emu get cnt 2
em m4
em h1
em h2
n = get nrow 0
for r ulong n bound 4096
emrow r
end
em h3
wout 2
ret 0
end
