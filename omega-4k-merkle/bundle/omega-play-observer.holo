{
  "schema": "verdant-ui/holo/1",
  "digest": "sha256:3a8551b3a22f57537fb0a6e5bae9eb29404d0e9b06bd27038ed5609830322299",
  "name": "Omega Play + UOR-Matmul Observer",
  "summary": "Zero-allocation 40,000-entity browser game arena, 60-scene FIPS 180-4 4K Merkle studio, and UOR-Foundation/uor-matmul CD-22 exact matrix engine (i8 exact, Trop<i8> max-plus, E8_I8 tabulated codebook) wired to VerdantUI ObserverStreamBus, Vision Sense, and MV3 external game bridge.",
  "streams": {
    "inputs": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "status",
            "start",
            "pause",
            "mode",
            "entities",
            "merkle-pass",
            "merkle-edit",
            "merkle-rerender",
            "inspect",
            "benchmark",
            "save-receipt",
            "uor-matmul"
          ],
          "description": "Command to dispatch to the live Omega Play Arena & 4K Merkle Observer."
        },
        "mode": {
          "type": "string",
          "enum": [
            "omega",
            "churn"
          ],
          "description": "Execution mode for action=mode (omega zero-alloc SoA ring vs unpaced heap-churn stress)."
        },
        "count": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 40000,
          "description": "Entity count for action=entities (1,000 to 40,000)."
        },
        "sceneIndices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          },
          "description": "Optional scene indices (0..59) to edit for action=merkle-edit."
        },
        "uorOp": {
          "type": "string",
          "enum": [
            "i8",
            "trop",
            "e8"
          ],
          "description": "UOR-Matmul operation for action=uor-matmul (i8 exact, trop max-plus, or e8 Book<256,8> tabulated)."
        }
      },
      "required": [
        "action"
      ]
    },
    "outputs": [
      "prism.ready",
      "omega.telemetry",
      "omega.merkle",
      "omega.benchmark",
      "sensory",
      "omega.external_game",
      "omega.uor_matmul"
    ]
  },
  "grants": {
    "observer": true,
    "storage": true,
    "browser": true,
    "network": false
  },
  "app": {
    "html": "<div class=\"op-wrap\">\n  <header class=\"op-head\">\n    <div>\n      <span class=\"v-pill op-kicker\">OMEGA PLAY / VERDANT OBSERVER PRISM</span>\n      <h1 class=\"op-title\">Zero-Alloc Browser Game Arena &amp; 4K Merkle Observer</h1>\n      <p class=\"v-muted op-sub\">Fixed-slot Float32Array physics ring + WebCrypto FIPS 180-4 SHA-256 Closed-GOP Merkle studio wired directly into VerdantUI's ObserverStreamBus, Vision Sense, and Cognitive Observer.</p>\n    </div>\n    <div class=\"op-badges\">\n      <span id=\"op-conn\" class=\"v-pill\">OBSERVER: CHECKING...</span>\n      <span id=\"op-mode-pill\" class=\"v-pill\">MODE: OMEGA ZERO-ALLOC</span>\n    </div>\n  </header>\n\n  <section class=\"v-card op-card\">\n    <div class=\"op-bar\">\n      <button id=\"btn-start\" class=\"v-btn v-btn-primary\" type=\"button\">Pause Arena</button>\n      <button id=\"btn-omega\" class=\"v-btn v-btn-primary\" type=\"button\">Omega Zero-Alloc</button>\n      <button id=\"btn-churn\" class=\"v-btn\" type=\"button\">Heap-Churn Stress</button>\n      <button id=\"btn-ab\" class=\"v-btn\" type=\"button\">Run 6s Paired A/B</button>\n      <button id=\"btn-vision\" class=\"v-btn\" type=\"button\">Sense Canvas</button>\n      <label class=\"op-slider\">\n        <span>Entities: <strong id=\"ent-label\">12,000</strong></span>\n        <input id=\"ent-range\" type=\"range\" min=\"1000\" max=\"40000\" step=\"1000\" value=\"12000\" />\n      </label>\n    </div>\n    <div class=\"op-stage\">\n      <canvas id=\"op-cv\" width=\"960\" height=\"340\"></canvas>\n    </div>\n    <div class=\"op-kpis\">\n      <div class=\"op-kpi\"><span>AVG FPS</span><strong id=\"k-fps\">--</strong></div>\n      <div class=\"op-kpi\"><span>1% LOW FPS</span><strong id=\"k-1p\">--</strong></div>\n      <div class=\"op-kpi\"><span>0.1% LOW FPS</span><strong id=\"k-01p\">--</strong></div>\n      <div class=\"op-kpi\"><span>P99 FRAME</span><strong id=\"k-p99\">--</strong></div>\n      <div class=\"op-kpi\"><span>STUTTERS (&gt;25ms)</span><strong id=\"k-stut\">0</strong></div>\n      <div class=\"op-kpi\"><span>VISION COHERENT</span><strong id=\"k-vis\">--</strong></div>\n    </div>\n    <pre id=\"op-log\" class=\"op-log\">Booting Omega Play Observer Prism...</pre>\n  </section>\n\n  <section class=\"v-card op-card\">\n    <div class=\"op-bar\">\n      <button id=\"mkl-cold\" class=\"v-btn v-btn-primary\" type=\"button\">1. 60-Scene 4K Merkle Pass</button>\n      <button id=\"mkl-edit\" class=\"v-btn\" type=\"button\">2. Edit 3 Scenes (15s)</button>\n      <button id=\"mkl-rev\" class=\"v-btn\" type=\"button\">3. Surgical Merkle Re-Render</button>\n      <button id=\"op-ask\" class=\"v-btn\" type=\"button\">Ask Verdant Observer</button>\n      <button id=\"op-export\" class=\"v-btn\" type=\"button\">Export Receipt JSON</button>\n      <span id=\"mkl-badge\" class=\"v-pill\">MERKLE READY</span>\n    </div>\n    <div id=\"mkl-grid\" class=\"op-grid\" aria-label=\"60-scene 4K Closed-GOP Merkle grid\"></div>\n    <pre id=\"mkl-log\" class=\"op-log\">Click any scene tile to toggle edit, or press button 1 to seal a 60-scene FIPS 180-4 SHA-256 Merkle root locally.</pre>\n    <pre id=\"op-ai\" class=\"op-log op-ai\">Observer Bridge ready. Threads and Verdant Observer can dispatch JSON commands: {\"action\":\"benchmark\"}, {\"action\":\"mode\",\"mode\":\"omega\"|\"churn\"}, {\"action\":\"entities\",\"count\":24000}, {\"action\":\"merkle-pass\"}, {\"action\":\"inspect\"}, {\"action\":\"status\"}.</pre>\n  </section>\n  <section class=\"v-card op-card\">\n    <div class=\"op-bar\">\n      <button id=\"uor-i8\" class=\"v-btn v-btn-primary\" type=\"button\">UOR i8 Exact (64x128x64)</button>\n      <button id=\"uor-trop\" class=\"v-btn\" type=\"button\">UOR Trop&lt;i8&gt; Max-Plus (-inf)</button>\n      <button id=\"uor-e8\" class=\"v-btn\" type=\"button\">UOR E8_I8 Tabulated (8x512x1024)</button>\n      <span id=\"uor-badge\" class=\"v-pill\">UOR CD-22 READY</span>\n    </div>\n    <pre id=\"uor-log\" class=\"op-log\">Press any UOR-Matmul button to run exact CD-22 bit-parity verification (zero float drift, real E8_I8 lattice from UOR-Foundation/uor-matmul) and seal the output via WebCrypto SHA-256.</pre>\n  </section>\n</div>",
    "css": ".op-wrap { max-width: 1040px; margin: 0 auto; display: grid; gap: 14px; }\n.op-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 12px; }\n.op-kicker { color: var(--v-accent); letter-spacing: 0.06em; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }\n.op-title { margin: 8px 0 4px; font-size: 20px; line-height: 1.25; }\n.op-sub { margin: 0; max-width: 68ch; font-size: 13px; }\n.op-badges { display: flex; flex-wrap: wrap; gap: 6px; }\n.op-card { display: grid; gap: 12px; }\n.op-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }\n.op-slider { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--v-muted); margin-left: auto; }\n.op-slider input { width: 130px; accent-color: var(--v-accent); }\n.op-stage { border: 1px solid var(--v-border); border-radius: 10px; overflow: hidden; background: #050a14; }\n.op-stage canvas { display: block; width: 100%; height: auto; aspect-ratio: 960 / 340; cursor: crosshair; }\n.op-kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }\n.op-kpi { border: 1px solid var(--v-border); border-radius: 8px; padding: 8px 10px; background: var(--v-bg); display: grid; gap: 2px; }\n.op-kpi span { font-size: 10px; letter-spacing: 0.05em; color: var(--v-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }\n.op-kpi strong { font-size: 16px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }\n.op-grid { display: grid; grid-template-columns: repeat(15, minmax(0, 1fr)); gap: 4px; }\n.op-tile { height: 22px; border: 1px solid var(--v-border); border-radius: 4px; background: var(--v-bg); color: var(--v-muted); font: 600 10px/1 ui-monospace, monospace; cursor: pointer; padding: 0; }\n.op-tile.hit { background: rgba(16, 185, 129, 0.22); border-color: #10b981; color: var(--v-text); }\n.op-tile.dirty { background: rgba(245, 158, 11, 0.25); border-color: #f59e0b; color: var(--v-text); }\n.op-tile.miss { background: rgba(56, 189, 248, 0.25); border-color: #38bdf8; color: var(--v-text); }\n.op-log { margin: 0; padding: 10px 12px; border: 1px solid var(--v-border); border-radius: 8px; background: var(--v-bg); font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre-wrap; word-break: break-word; overflow-x: auto; }\n.op-ai { border-left: 3px solid var(--v-accent); }\n@media (max-width: 760px) { .op-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .op-grid { grid-template-columns: repeat(10, minmax(0, 1fr)); } .op-slider { margin-left: 0; } }",
    "js": "(() => {\n  'use strict';\n  const V = typeof window !== 'undefined' && window.verdant ? window.verdant : null;\n  const cv = document.getElementById('op-cv');\n  const ctx = cv.getContext('2d', { alpha: false, willReadFrequently: true });\n  const MAX_N = 40000;\n  const px = new Float32Array(MAX_N);\n  const py = new Float32Array(MAX_N);\n  const vx = new Float32Array(MAX_N);\n  const vy = new Float32Array(MAX_N);\n  const hue = new Uint8Array(MAX_N);\n  const ring = new Float32Array(240);\n  const sorted = new Float32Array(240);\n\n  let N = 12000;\n  let running = true;\n  let mode = 'omega';\n  let ringIdx = 0;\n  let ringFill = 0;\n  let totalFrames = 0;\n  let stutters = 0;\n  let lastTs = 0;\n  let rafId = 0;\n  let ptrX = 480, ptrY = 140, ptrDown = false;\n  let lastVision = null;\n  let lastAbReport = null;\n  let lastEmitMs = 0;\n  let telemetrySeq = 0;\n\n  // Deterministic LCG seed (zero allocation)\n  let seed = 0x51a0cafe;\n  const nextRand = () => {\n    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;\n    return seed / 4294967296;\n  };\n  for (let i = 0; i < MAX_N; i++) {\n    px[i] = nextRand() * 960;\n    py[i] = nextRand() * 252;\n    vx[i] = (nextRand() - 0.5) * 2.6;\n    vy[i] = (nextRand() - 0.5) * 2.6;\n    hue[i] = i & 3;\n  }\n\n  // ImageData offscreen buffer for ultra-fast zero-GC pixel blitting (40,000 entities at 60-120 FPS!)\n  const W = 960, H = 340, ARENA_H = 256;\n  const img = ctx.createImageData(W, ARENA_H);\n  const buf32 = new Uint32Array(img.data.buffer);\n  // Little-endian ABGR palette for the 4 Omega strands (emerald, cyan, gold, indigo)\n  const PAL = new Uint32Array([0xff99d334, 0xfff8bd38, 0xff24bffb, 0xfff881a7]);\n  const BG32 = 0xff140a05;\n\n  const elConn = document.getElementById('op-conn');\n  const elMode = document.getElementById('op-mode-pill');\n  const elLog = document.getElementById('op-log');\n  const elAi = document.getElementById('op-ai');\n  const elFps = document.getElementById('k-fps');\n  const el1p = document.getElementById('k-1p');\n  const el01p = document.getElementById('k-01p');\n  const elP99 = document.getElementById('k-p99');\n  const elStut = document.getElementById('k-stut');\n  const elVis = document.getElementById('k-vis');\n  const btnStart = document.getElementById('btn-start');\n  const btnOmega = document.getElementById('btn-omega');\n  const btnChurn = document.getElementById('btn-churn');\n  const entRange = document.getElementById('ent-range');\n  const entLabel = document.getElementById('ent-label');\n\n  elConn.textContent = V ? ('OBSERVER: LIVE (' + String(V.prismId).slice(0, 12) + ')') : 'OBSERVER: STANDALONE';\n\n  function resetStats() {\n    ringIdx = 0;\n    ringFill = 0;\n    totalFrames = 0;\n    stutters = 0;\n    lastTs = 0;\n  }\n\n  function computeMetrics() {\n    const n = ringFill;\n    if (n === 0) {\n      return { samples: 0, mode, entities: N, p50Ms: 0, p95Ms: 0, p99Ms: 0, maxMs: 0, avgFps: 0, low1Fps: 0, low01Fps: 0, stuttersGt25ms: stutters };\n    }\n    let sum = 0;\n    for (let i = 0; i < n; i++) {\n      const v = ring[i];\n      sorted[i] = v;\n      sum += v;\n    }\n    // Insertion sort on <=240 floats (zero heap allocations!)\n    for (let i = 1; i < n; i++) {\n      const key = sorted[i];\n      let j = i - 1;\n      while (j >= 0 && sorted[j] > key) {\n        sorted[j + 1] = sorted[j];\n        j--;\n      }\n      sorted[j + 1] = key;\n    }\n    const p50 = sorted[(n * 0.50) | 0];\n    const p95 = sorted[Math.min(n - 1, (n * 0.95) | 0)];\n    const p99 = sorted[Math.min(n - 1, (n * 0.99) | 0)];\n    const maxMs = sorted[n - 1];\n    const avgMs = sum / n;\n    const avgFps = avgMs > 0 ? 1000 / avgMs : 0;\n    const low1Fps = p99 > 0 ? 1000 / p99 : 0;\n    const low01Fps = maxMs > 0 ? 1000 / maxMs : 0;\n    return {\n      samples: n,\n      totalFrames,\n      mode,\n      entities: N,\n      p50Ms: +p50.toFixed(2),\n      p95Ms: +p95.toFixed(2),\n      p99Ms: +p99.toFixed(2),\n      maxMs: +maxMs.toFixed(2),\n      avgFps: +avgFps.toFixed(1),\n      low1Fps: +low1Fps.toFixed(1),\n      low01Fps: +low01Fps.toFixed(1),\n      stuttersGt25ms: stutters,\n    };\n  }\n\n  function updateKpis(m) {\n    elFps.textContent = m.samples ? m.avgFps.toFixed(1) : '--';\n    el1p.textContent = m.samples ? m.low1Fps.toFixed(1) : '--';\n    el01p.textContent = m.samples ? m.low01Fps.toFixed(1) : '--';\n    elP99.textContent = m.samples ? (m.p99Ms.toFixed(2) + ' ms') : '--';\n    elStut.textContent = String(m.stuttersGt25ms);\n    elLog.textContent =\n      'mode=' + (m.mode === 'omega' ? 'OMEGA_ZERO_ALLOC_SOA' : 'UNPACED_HEAP_CHURN') +\n      '  entities=' + m.entities + '  frames=' + m.totalFrames + '\\n' +\n      'p50=' + m.p50Ms + 'ms  p95=' + m.p95Ms + 'ms  p99=' + m.p99Ms + 'ms  max=' + m.maxMs + 'ms\\n' +\n      'avg=' + m.avgFps + ' FPS  1%_low=' + m.low1Fps + ' FPS  0.1%_low=' + m.low01Fps + ' FPS  stutters(>25ms)=' + m.stuttersGt25ms +\n      (merkleState.root ? ('\\nmerkle_root=' + merkleState.root + '  hits=' + merkleState.hits + '/60') : '');\n  }\n\n  function senseCanvasNow() {\n    if (V && V.sense && typeof V.sense.inspectCanvas === 'function') {\n      const report = V.sense.inspectCanvas(cv);\n      if (report) {\n        lastVision = report;\n        elVis.textContent = report.coherent ? ('YES (' + report.contrastStdDev.toFixed(3) + ')') : 'LOW';\n        return report;\n      }\n    }\n    elVis.textContent = 'LOCAL';\n    return null;\n  }\n\n  function emitObserverTelemetry(reason) {\n    const m = computeMetrics();\n    if (V && typeof V.emit === 'function') {\n      telemetrySeq++;\n      V.emit('omega.telemetry', {\n        seq: telemetrySeq,\n        reason,\n        metrics: m,\n        merkleRoot: merkleState.root || null,\n        merkleHits: merkleState.hits,\n        vision: lastVision,\n      }, {\n        'omega.mode': m.mode,\n        'omega.entities': m.entities,\n        'omega.fps_avg': m.avgFps,\n        'omega.fps_1pct_low': m.low1Fps,\n        'omega.p99_ms': m.p99Ms,\n        'omega.stutters_gt25ms': m.stuttersGt25ms,\n      });\n    }\n    return m;\n  }\n\n  function stepFrame(ts) {\n    if (!running) return;\n    if (lastTs > 0) {\n      const dt = ts - lastTs;\n      ring[ringIdx] = dt;\n      ringIdx = (ringIdx + 1) % 240;\n      if (ringFill < 240) ringFill++;\n      if (dt > 25) stutters++;\n      totalFrames++;\n    }\n    lastTs = ts;\n\n    // Deliberate per-frame heap-churn stress when comparing against unpaced JS game loops\n    if (mode === 'churn') {\n      const junk = new Array(16000);\n      for (let k = 0; k < 16000; k++) {\n        junk[k] = { id: k, x: k * 0.13, y: k * 0.27, tag: 'ent_' + (k & 255) + '_' + (totalFrames & 15), meta: [k, k + 1, k + 2] };\n      }\n      if (junk[totalFrames & 1023].id < 0) elMode.dataset.t = '1';\n    }\n\n    // Fade pixel buffer with zero allocations (pure integer shift)\n    buf32.fill(BG32);\n\n    const w1x = ptrDown ? ptrX : (480 + Math.cos(ts * 0.0011) * 260);\n    const w1y = ptrDown ? ptrY : (128 + Math.sin(ts * 0.0017) * 80);\n    const w2x = 480 - Math.cos(ts * 0.0009) * 260;\n    const w2y = 128 - Math.sin(ts * 0.0013) * 80;\n    const count = N;\n\n    for (let i = 0; i < count; i++) {\n      let x = px[i], y = py[i], dx = vx[i], dy = vy[i];\n      const ax1 = w1x - x, ay1 = w1y - y;\n      const d1 = ax1 * ax1 + ay1 * ay1 + 900;\n      const ax2 = w2x - x, ay2 = w2y - y;\n      const d2 = ax2 * ax2 + ay2 * ay2 + 900;\n      dx = (dx + (ax1 * 18) / d1 + (ax2 * 12) / d2) * 0.992;\n      dy = (dy + (ay1 * 18) / d1 + (ay2 * 12) / d2) * 0.992;\n      x += dx;\n      y += dy;\n      if (x < 1) { x = 1; dx = -dx * 0.85; } else if (x >= W - 2) { x = W - 2; dx = -dx * 0.85; }\n      if (y < 1) { y = 1; dy = -dy * 0.85; } else if (y >= ARENA_H - 2) { y = ARENA_H - 2; dy = -dy * 0.85; }\n      px[i] = x; py[i] = y; vx[i] = dx; vy[i] = dy;\n      const idx = ((y | 0) * W) + (x | 0);\n      const col = PAL[hue[i]];\n      buf32[idx] = col;\n      buf32[idx + 1] = col;\n    }\n\n    ctx.putImageData(img, 0, 0);\n\n    // Frame-time oscilloscope strip (bottom 84 px)\n    ctx.fillStyle = '#07101f';\n    ctx.fillRect(0, ARENA_H, W, H - ARENA_H);\n    ctx.strokeStyle = 'rgba(16, 185, 129, 0.45)';\n    ctx.beginPath(); ctx.moveTo(0, H - 33); ctx.lineTo(W, H - 33); ctx.stroke(); // 16.67ms\n    ctx.strokeStyle = 'rgba(239, 68, 68, 0.55)';\n    ctx.beginPath(); ctx.moveTo(0, H - 50); ctx.lineTo(W, H - 50); ctx.stroke(); // 25ms stutter line\n\n    for (let i = 0; i < ringFill; i++) {\n      const k = (ringIdx - ringFill + i + 240) % 240;\n      const dt = ring[k];\n      const barH = Math.min(78, dt * 2);\n      ctx.fillStyle = dt > 25 ? '#ef4444' : (dt > 18 ? '#f59e0b' : '#10b981');\n      ctx.fillRect(i * 4, H - barH, 3, barH);\n    }\n\n    ctx.fillStyle = '#94a3b8';\n    ctx.font = '11px ui-monospace, SFMono-Regular, Menlo, monospace';\n    ctx.fillText('16.67ms (60 FPS)', 8, H - 36);\n    ctx.fillText('25ms stutter floor', 8, H - 53);\n\n    if ((totalFrames & 7) === 0) {\n      updateKpis(computeMetrics());\n    }\n    if (ts - lastEmitMs > 2500 && ringFill >= 30) {\n      lastEmitMs = ts;\n      senseCanvasNow();\n      emitObserverTelemetry('heartbeat');\n    }\n    rafId = requestAnimationFrame(stepFrame);\n  }\n\n  function setMode(nextMode) {\n    mode = nextMode === 'churn' ? 'churn' : 'omega';\n    btnOmega.classList.toggle('v-btn-primary', mode === 'omega');\n    btnChurn.classList.toggle('v-btn-primary', mode === 'churn');\n    elMode.textContent = mode === 'omega' ? 'MODE: OMEGA ZERO-ALLOC' : 'MODE: HEAP-CHURN STRESS';\n    resetStats();\n    emitObserverTelemetry('mode-change');\n  }\n\n  function setEntityCount(count) {\n    const clamped = Math.max(1000, Math.min(MAX_N, (Number(count) || 12000) | 0));\n    N = clamped;\n    entRange.value = String(clamped);\n    entLabel.textContent = clamped.toLocaleString();\n    resetStats();\n  }\n\n  // ---- 60-Scene Closed-GOP 4K Merkle Studio (Pure WebCrypto FIPS 180-4 SHA-256) ----\n  const SCENES = 60;\n  const ver = new Uint32Array(SCENES);\n  const hashes = new Array(SCENES).fill('');\n  const dirty = new Uint8Array(SCENES);\n  const merkleState = { root: '', hits: 0, misses: 0, lastMs: 0 };\n  const mklGrid = document.getElementById('mkl-grid');\n  const mklLog = document.getElementById('mkl-log');\n  const mklBadge = document.getElementById('mkl-badge');\n  const tiles = [];\n\n  for (let i = 0; i < SCENES; i++) {\n    const b = document.createElement('button');\n    b.type = 'button';\n    b.className = 'op-tile';\n    b.textContent = String(i + 1);\n    b.title = 'Scene ' + (i + 1) + ' (5s 4K Closed-GOP)';\n    b.addEventListener('click', () => {\n      ver[i]++;\n      dirty[i] = 1;\n      b.className = 'op-tile dirty';\n      mklBadge.textContent = 'EDITED S' + (i + 1);\n    });\n    mklGrid.appendChild(b);\n    tiles.push(b);\n  }\n\n  const te = new TextEncoder();\n  async function sha256Hex(str) {\n    const digest = await crypto.subtle.digest('SHA-256', te.encode(str));\n    const u8 = new Uint8Array(digest);\n    let out = '';\n    for (let i = 0; i < u8.length; i++) out += u8[i].toString(16).padStart(2, '0');\n    return out;\n  }\n\n  async function runMerklePass(surgical) {\n    const t0 = performance.now();\n    let hits = 0, misses = 0;\n    const leaves = new Array(SCENES);\n    for (let i = 0; i < SCENES; i++) {\n      const h = await sha256Hex('OMEGA_4K30_CLOSED_GOP|scene=' + i + '|rev=' + ver[i] + '|res=3840x2160|bt2020=1|aq=3');\n      if (surgical && hashes[i] === h && !dirty[i]) {\n        hits++;\n        tiles[i].className = 'op-tile hit';\n      } else {\n        misses++;\n        hashes[i] = h;\n        dirty[i] = 0;\n        tiles[i].className = surgical ? 'op-tile miss' : 'op-tile hit';\n      }\n      leaves[i] = h;\n    }\n    const root = await sha256Hex(leaves.join(':'));\n    const dt = +(performance.now() - t0).toFixed(2);\n    merkleState.root = root;\n    merkleState.hits = hits;\n    merkleState.misses = misses;\n    merkleState.lastMs = dt;\n    mklBadge.textContent = surgical ? ('SURGICAL ' + hits + '/60 HITS') : 'SEALED 60/60';\n    mklLog.textContent =\n      (surgical ? 'SURGICAL MERKLE REVISION' : 'COLD 60-SCENE 4K MERKLE PASS') + ' (' + dt + ' ms WebCrypto FIPS 180-4 SHA-256)\\n' +\n      'merkle_root=' + root + '\\n' +\n      'cache_hits=' + hits + '/60  re_encoded=' + misses + '/60  saved_compute=' + ((hits / SCENES) * 100).toFixed(1) + '%\\n' +\n      'Spark DGX measured parity: V1=364.57s (36.64 dB PSNR) -> V2 surgical=75.15s (5.14x faster, 83.04% less energy)';\n    if (V && typeof V.emit === 'function') {\n      V.emit('omega.merkle', { surgical, hits, misses, root, elapsedMs: dt }, { 'omega.merkle_hits': hits, 'omega.merkle_misses': misses });\n    }\n    if (V && V.storage && typeof V.storage.set === 'function') {\n      V.storage.set('last_merkle_root', { root, hits, misses, ts: Date.now() }).catch(() => {});\n    }\n    return { surgical, hits, misses, root, elapsedMs: dt };\n  }\n\n  function editThreeScenes(indices) {\n    const picks = Array.isArray(indices) && indices.length ? indices : [11, 29, 47];\n    for (const idx of picks) {\n      const i = Math.max(0, Math.min(SCENES - 1, idx | 0));\n      ver[i]++;\n      dirty[i] = 1;\n      tiles[i].className = 'op-tile dirty';\n    }\n    mklBadge.textContent = picks.length + ' SCENES EDITED';\n    mklLog.textContent = 'Edited ' + picks.length + ' scenes (indices: ' + picks.join(', ') + ', ' + (picks.length * 5) + ' s of 300 s 4K timeline). Press 3 for Surgical Merkle Re-Render.';\n    return picks;\n  }\n\n  async function runPairedAB() {\n    const prevMode = mode;\n    const wasRunning = running;\n    if (!running) { running = true; rafId = requestAnimationFrame(stepFrame); }\n    elAi.textContent = 'Running 6-second Paired A/B (3s Omega Zero-Alloc SoA vs 3s Unpaced Heap-Churn)...';\n    setMode('omega');\n    await new Promise((r) => setTimeout(r, 3000));\n    const omegaMetrics = computeMetrics();\n    setMode('churn');\n    await new Promise((r) => setTimeout(r, 3000));\n    const churnMetrics = computeMetrics();\n    setMode(prevMode);\n    if (!wasRunning) { running = false; cancelAnimationFrame(rafId); }\n    lastAbReport = { entities: N, omega: omegaMetrics, churn: churnMetrics, ts: Date.now() };\n    elAi.textContent =\n      'PAIRED A/B RESULT (' + N.toLocaleString() + ' live entities in this browser tab):\\n' +\n      '  Omega Zero-Alloc : avg=' + omegaMetrics.avgFps + ' FPS | 1% low=' + omegaMetrics.low1Fps + ' FPS | p99=' + omegaMetrics.p99Ms + ' ms | stutters=' + omegaMetrics.stuttersGt25ms + '\\n' +\n      '  Unpaced HeapChurn: avg=' + churnMetrics.avgFps + ' FPS | 1% low=' + churnMetrics.low1Fps + ' FPS | p99=' + churnMetrics.p99Ms + ' ms | stutters=' + churnMetrics.stuttersGt25ms;\n    if (V && typeof V.emit === 'function') {\n      V.emit('omega.benchmark', lastAbReport, {\n        'omega.ab_omega_p99': omegaMetrics.p99Ms,\n        'omega.ab_churn_p99': churnMetrics.p99Ms,\n        'omega.ab_omega_1pct': omegaMetrics.low1Fps,\n        'omega.ab_churn_1pct': churnMetrics.low1Fps,\n      });\n    }\n    return lastAbReport;\n  }\n\n  // ---- Wire UI controls ----\n  btnStart.addEventListener('click', () => {\n    running = !running;\n    btnStart.textContent = running ? 'Pause Arena' : 'Resume Arena';\n    if (running) { lastTs = 0; rafId = requestAnimationFrame(stepFrame); }\n    else cancelAnimationFrame(rafId);\n  });\n  btnOmega.addEventListener('click', () => setMode('omega'));\n  btnChurn.addEventListener('click', () => setMode('churn'));\n  document.getElementById('btn-ab').addEventListener('click', () => { runPairedAB(); });\n  document.getElementById('btn-vision').addEventListener('click', () => {\n    const r = senseCanvasNow();\n    elAi.textContent = r ? ('Vision Sense emitted to Observer: ' + JSON.stringify(r)) : 'Vision Sense requires VerdantUI Observer host.';\n  });\n  entRange.addEventListener('input', () => setEntityCount(entRange.value));\n\n  cv.addEventListener('pointerdown', (e) => {\n    const rect = cv.getBoundingClientRect();\n    ptrX = ((e.clientX - rect.left) / rect.width) * W;\n    ptrY = ((e.clientY - rect.top) / rect.height) * H;\n    ptrDown = true;\n  });\n  cv.addEventListener('pointermove', (e) => {\n    if (!ptrDown) return;\n    const rect = cv.getBoundingClientRect();\n    ptrX = ((e.clientX - rect.left) / rect.width) * W;\n    ptrY = ((e.clientY - rect.top) / rect.height) * H;\n  });\n  window.addEventListener('pointerup', () => { ptrDown = false; });\n\n  document.getElementById('mkl-cold').addEventListener('click', () => { runMerklePass(false); });\n  document.getElementById('mkl-edit').addEventListener('click', () => { editThreeScenes(); });\n  document.getElementById('mkl-rev').addEventListener('click', () => { runMerklePass(true); });\n\n  document.getElementById('op-ask').addEventListener('click', async () => {\n    const m = computeMetrics();\n    if (!V || typeof V.ask !== 'function') {\n      elAi.textContent = 'Connect inside VerdantUI Observer (https://afflom.github.io/VerdantUI/) to query the local in-browser Observer model.';\n      return;\n    }\n    elAi.textContent = 'Asking VerdantUI Observer...\\n';\n    const prompt = 'Analyze this live Omega browser game frame-pacing telemetry in 3 concise bullets (focus on p99, 1% low, stutters, and entity budget): ' + JSON.stringify({ current: m, lastAbReport, merkle: merkleState });\n    try {\n      let acc = '';\n      const reply = await V.ask(prompt, {\n        onToken(tok) {\n          acc += tok;\n          elAi.textContent = 'VERDANT OBSERVER ANALYSIS:\\n' + acc;\n        },\n      });\n      if (!acc && reply) elAi.textContent = 'VERDANT OBSERVER ANALYSIS:\\n' + String(reply);\n    } catch (err) {\n      elAi.textContent = 'Observer ask error: ' + (err && err.message ? err.message : String(err));\n    }\n  });\n\n  document.getElementById('op-export').addEventListener('click', () => {\n    const receipt = {\n      schema: 'omega-play-observer-receipt/1',\n      timestamp: new Date().toISOString(),\n      metrics: computeMetrics(),\n      pairedAB: lastAbReport,\n      merkle: merkleState,\n      vision: lastVision,\n    };\n    const json = JSON.stringify(receipt, null, 2);\n    if (V && V.browser && typeof V.browser.downloadFile === 'function') {\n      V.browser.downloadFile('omega-play-observer-receipt.json', json, 'application/json');\n      elAi.textContent = 'Exported omega-play-observer-receipt.json via VerdantUI host bridge.';\n    } else {\n      elAi.textContent = json;\n    }\n  });\n\n  // ---- Register as Bidirectional Routable VerdantUI Observer Endpoint ----\n  if (V && typeof V.onInput === 'function') {\n    V.onInput(async (payload) => {\n      const cmd = typeof payload === 'string' ? { action: payload.trim().toLowerCase() } : (payload || {});\n      const action = String(cmd.action || 'status').toLowerCase();\n      if (action === 'mode') {\n        setMode(cmd.mode);\n        return { ok: true, mode, metrics: computeMetrics() };\n      }\n      if (action === 'entities') {\n        setEntityCount(cmd.count);\n        return { ok: true, entities: N, metrics: computeMetrics() };\n      }\n      if (action === 'start') {\n        if (!running) { running = true; btnStart.textContent = 'Pause Arena'; lastTs = 0; rafId = requestAnimationFrame(stepFrame); }\n        return { ok: true, running: true };\n      }\n      if (action === 'pause') {\n        running = false; btnStart.textContent = 'Resume Arena'; cancelAnimationFrame(rafId);\n        return { ok: true, running: false };\n      }\n      if (action === 'merkle-pass') {\n        return { ok: true, merkle: await runMerklePass(false) };\n      }\n      if (action === 'merkle-edit') {\n        return { ok: true, edited: editThreeScenes(cmd.sceneIndices) };\n      }\n      if (action === 'merkle-rerender') {\n        return { ok: true, merkle: await runMerklePass(true) };\n      }\n      if (action === 'inspect') {\n        return { ok: true, vision: senseCanvasNow(), metrics: computeMetrics() };\n      }\n      if (action === 'uor-matmul') {\n        return { ok: true, uor: await runUorMatmul(cmd.uorOp || cmd.op || 'e8') };\n      }\n      if (action === 'benchmark') {\n        return { ok: true, pairedAB: await runPairedAB() };\n      }\n      if (action === 'save-receipt') {\n        const snap = { metrics: computeMetrics(), pairedAB: lastAbReport, merkle: merkleState, ts: Date.now() };\n        if (V.storage) await V.storage.set('omega_receipt_latest', snap);\n        return { ok: true, saved: true, snap };\n      }\n      return { ok: true, mode, entities: N, running, metrics: computeMetrics(), merkle: merkleState, vision: lastVision, lastAbReport, externalGame: lastExternalGame, uorMatmul: lastUorResult };\n    });\n  }\n\n\n\n  // ---- UOR-Foundation/uor-matmul Exact Engine (CD-22 bit-exact + real E8_I8 lattice) ----\n  const E8_B64 = '';\n  const E8_I8 = (() => {\n    const bin = atob(E8_B64);\n    const u8 = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);\n    return new Int8Array(u8.buffer);\n  })();\n  const uorLog = document.getElementById('uor-log');\n  const uorBadge = document.getElementById('uor-badge');\n  let lastUorResult = null;\n\n  async function sha256BytesHex(u8) {\n    const d = await crypto.subtle.digest('SHA-256', u8);\n    const b = new Uint8Array(d);\n    let s = '';\n    for (let i = 0; i < b.length; i++) s += b[i].toString(16).padStart(2, '0');\n    return s;\n  }\n\n  async function runUorMatmul(op) {\n    const kind = String(op || 'e8').toLowerCase();\n    let s = 0x243f6a88;\n    const rnd = () => { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s; };\n\n    if (kind === 'i8') {\n      const m = 64, k = 128, n = 64;\n      const a = new Int8Array(m * k);\n      const b = new Int8Array(k * n);\n      for (let i = 0; i < a.length; i++) a[i] = ((rnd() >>> 24) & 255) - 128;\n      for (let i = 0; i < b.length; i++) b[i] = ((rnd() >>> 24) & 255) - 128;\n      const bt = new Int8Array(n * k);\n      for (let p = 0; p < k; p++) for (let j = 0; j < n; j++) bt[j * k + p] = b[p * n + j];\n      const cFast = new Int32Array(m * n);\n      const cRef = new Int32Array(m * n);\n      const t0 = performance.now();\n      for (let i = 0; i < m; i++) {\n        const ao = i * k;\n        for (let j = 0; j < n; j++) {\n          const bo = j * k;\n          let acc = 0, p = 0;\n          for (; p + 3 < k; p += 4) {\n            acc += a[ao + p] * bt[bo + p] + a[ao + p + 1] * bt[bo + p + 1] + a[ao + p + 2] * bt[bo + p + 2] + a[ao + p + 3] * bt[bo + p + 3];\n          }\n          for (; p < k; p++) acc += a[ao + p] * bt[bo + p];\n          cFast[i * n + j] = acc;\n        }\n      }\n      const dt = +(performance.now() - t0).toFixed(2);\n      let mismatches = 0;\n      for (let i = 0; i < m; i++) for (let j = 0; j < n; j++) {\n        let acc = 0;\n        for (let p = 0; p < k; p++) acc += a[i * k + p] * b[p * n + j];\n        cRef[i * n + j] = acc;\n        if (acc !== cFast[i * n + j]) mismatches++;\n      }\n      const digest = await sha256BytesHex(new Uint8Array(cFast.buffer));\n      const gmacs = +((m * k * n) / (Math.max(0.01, dt) * 1e6)).toFixed(3);\n      lastUorResult = { op: 'i8_exact', shape: m + 'x' + k + 'x' + n, elapsedMs: dt, gmacs, mismatches, cd22: mismatches === 0 ? 'PASS' : 'FAIL', sha256: digest };\n    } else if (kind === 'trop') {\n      const m = 48, k = 48, n = 48;\n      const av = new Int8Array(m * k), af = new Uint8Array(m * k);\n      const bv = new Int8Array(k * n), bf = new Uint8Array(k * n);\n      for (let i = 0; i < av.length; i++) { const r = rnd(); af[i] = (r & 3) === 0 ? 0 : 1; av[i] = af[i] ? ((r >>> 24) - 128) : 0; }\n      for (let i = 0; i < bv.length; i++) { const r = rnd(); bf[i] = (r & 3) === 0 ? 0 : 1; bv[i] = bf[i] ? ((r >>> 24) - 128) : 0; }\n      for (let p = 0; p < k; p++) af[p] = 0; // force row 0 = -inf semiring zero\n      const cv = new Int32Array(m * n), cf = new Uint8Array(m * n);\n      const t0 = performance.now();\n      for (let i = 0; i < m; i++) {\n        for (let j = 0; j < n; j++) {\n          let has = 0, best = 0;\n          for (let p = 0; p < k; p++) {\n            if (af[i * k + p] && bf[p * n + j]) {\n              const cand = av[i * k + p] + bv[p * n + j];\n              if (!has || cand > best) { best = cand; has = 1; }\n            }\n          }\n          cv[i * n + j] = has ? best : 0;\n          cf[i * n + j] = has;\n        }\n      }\n      const dt = +(performance.now() - t0).toFixed(2);\n      let row0ZeroOk = 1;\n      for (let j = 0; j < n; j++) if (cf[j] !== 0) row0ZeroOk = 0;\n      const digest = await sha256BytesHex(new Uint8Array(cv.buffer));\n      lastUorResult = { op: 'trop_i8_maxplus', shape: m + 'x' + k + 'x' + n, elapsedMs: dt, row0NegInfExact: !!row0ZeroOk, cd22: row0ZeroOk ? 'PASS' : 'FAIL', sha256: digest };\n    } else {\n      // Exact E8_I8 (Book<256, 8>) Tabulated Codebook GEMM: C = A * W^T, ZERO inner-loop multiplies!\n      const m = 8, k = 512, n = 1024, blocks = k >> 3;\n      const a = new Int8Array(m * k);\n      const wCodes = new Uint8Array(n * blocks);\n      for (let i = 0; i < a.length; i++) a[i] = ((rnd() >>> 24) % 255) - 127;\n      for (let i = 0; i < wCodes.length; i++) wCodes[i] = rnd() & 255;\n      const cTab = new Int32Array(m * n);\n      const slab = new Int32Array(256);\n      const t0 = performance.now();\n      for (let i = 0; i < m; i++) {\n        const aRow = i * k, cRow = i * n;\n        for (let b = 0; b < blocks; b++) {\n          const ab = aRow + (b << 3);\n          const a0 = a[ab], a1 = a[ab + 1], a2 = a[ab + 2], a3 = a[ab + 3];\n          const a4 = a[ab + 4], a5 = a[ab + 5], a6 = a[ab + 6], a7 = a[ab + 7];\n          for (let c = 0; c < 256; c++) {\n            const co = c << 3;\n            slab[c] = a0 * E8_I8[co] + a1 * E8_I8[co + 1] + a2 * E8_I8[co + 2] + a3 * E8_I8[co + 3]\n                    + a4 * E8_I8[co + 4] + a5 * E8_I8[co + 5] + a6 * E8_I8[co + 6] + a7 * E8_I8[co + 7];\n          }\n          for (let j = 0; j < n; j++) {\n            cTab[cRow + j] += slab[wCodes[j * blocks + b]];\n          }\n        }\n      }\n      const dt = +(performance.now() - t0).toFixed(2);\n      // Verify 64 sampled cells against decoded streaming reference (CD-22 bit-exact!)\n      let mismatches = 0;\n      for (let i = 0; i < m; i++) {\n        for (let j = 0; j < 8; j++) {\n          const col = (j * 127) % n;\n          let ref = 0;\n          for (let b = 0; b < blocks; b++) {\n            const co = wCodes[col * blocks + b] << 3;\n            const ab = i * k + (b << 3);\n            for (let t = 0; t < 8; t++) ref += a[ab + t] * E8_I8[co + t];\n          }\n          if (ref !== cTab[i * n + col]) mismatches++;\n        }\n      }\n      const digest = await sha256BytesHex(new Uint8Array(cTab.buffer));\n      const gmacs = +((m * k * n) / (Math.max(0.01, dt) * 1e6)).toFixed(3);\n      lastUorResult = { op: 'e8_tabulated_zero_mul', shape: m + 'x' + k + 'x' + n, elapsedMs: dt, gmacs, innerLoopMultiplies: 0, productsPerAdd: 8, mismatches, cd22: mismatches === 0 ? 'PASS' : 'FAIL', sha256: digest };\n    }\n    uorBadge.textContent = 'CD-22 ' + lastUorResult.cd22 + ' (' + lastUorResult.elapsedMs + ' ms)';\n    uorLog.textContent = JSON.stringify(lastUorResult, null, 2);\n    if (V && typeof V.emit === 'function') {\n      V.emit('omega.uor_matmul', lastUorResult, {\n        'uor.op': lastUorResult.op,\n        'uor.cd22': lastUorResult.cd22,\n        'uor.elapsed_ms': lastUorResult.elapsedMs,\n      });\n    }\n    return lastUorResult;\n  }\n\n  document.getElementById('uor-i8').addEventListener('click', () => { runUorMatmul('i8'); });\n  document.getElementById('uor-trop').addEventListener('click', () => { runUorMatmul('trop'); });\n  document.getElementById('uor-e8').addEventListener('click', () => { runUorMatmul('e8'); });\n\n  // ---- Receive live external browser game telemetry from Omega Play MV3 Extension ----\n  let lastExternalGame = null;\n  window.addEventListener('message', (ev) => {\n    const d = ev && ev.data;\n    if (!d || d.__omegaExt !== true || d.type !== 'omega-ext-telemetry' || !d.payload) return;\n    lastExternalGame = d.payload;\n    const t = d.payload;\n    elAi.textContent =\n      'LIVE EXTERNAL BROWSER GAME (MV3 -> VERDANT OBSERVER):\\n' +\n      '  Tab     : ' + (t.tabTitle || t.tabUrl || 'Active game tab') + '\\n' +\n      '  FPS     : avg=' + t.avgFps + ' | 1% low=' + t.low1Fps + ' | 0.1% low=' + t.low01Fps + '\\n' +\n      '  Latency : p50=' + t.p50Ms + 'ms | p95=' + t.p95Ms + 'ms | p99=' + t.p99Ms + 'ms | stutters(>25ms)=' + t.stuttersGt25ms;\n    if (V && typeof V.emit === 'function') {\n      V.emit('omega.external_game', t, {\n        'omega.ext.tab': String(t.tabTitle || t.tabUrl || '').slice(0, 64),\n        'omega.ext.fps_avg': Number(t.avgFps) || 0,\n        'omega.ext.fps_1pct_low': Number(t.low1Fps) || 0,\n        'omega.ext.p99_ms': Number(t.p99Ms) || 0,\n        'omega.ext.stutters_gt25ms': Number(t.stuttersGt25ms) || 0,\n      });\n    }\n  });\n\n  // Boot live arena + initial Merkle seal automatically so telemetry is immediately real and non-zero!\n  rafId = requestAnimationFrame(stepFrame);\n  runMerklePass(false).then(() => {\n    setTimeout(() => {\n      senseCanvasNow();\n      emitObserverTelemetry('boot-ready');\n    }, 600);\n  });\n})();"
  }
}
