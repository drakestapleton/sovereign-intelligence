text hd2 " · Omega Forge</title>\n<style>\n:root{color-scheme:light dark;--bg:#fff;--fg:#1b1f24;--mu:#59636e;--ln:#d1d9e0;--ac:#0b62d6;--ok:#1a7f37;--bad:#cf222e;--mg:#8250df;--cd:#f6f8fa}\n@media (prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--mu:#9198a1;--ln:#3d444d;--ac:#4493f8;--ok:#3fb950;--bad:#f85149;--mg:#ab7df8;--cd:#151b23}}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,\"Segoe UI\",sans-serif}\nheader,main,footer{max-width:980px;margin:0 auto;padding:12px 16px}\nheader{border-bottom:1px solid var(--ln)}\nheader a{font-weight:600;color:var(--fg);text-decoration:none}\nfooter{color:var(--mu);font-size:13px;border-top:1px solid var(--ln);margin-top:32px}\na{color:var(--ac)}\nh1{font-size:24px;margin:16px 0 4px;overflow-wrap:anywhere}\nh2{font-size:18px;margin:28px 0 8px;padding-bottom:4px;border-bottom:1px solid var(--ln)}\n.mu{color:var(--mu)}\n.tw{overflow-x:auto}\ntable{width:100%;border-collapse:collapse}\nth,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--ln);vertical-align:top}\nth{font-size:13px;color:var(--mu);font-weight:600}\n.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}\ncode,pre{font:13px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--cd);border-radius:6px}\ncode{padding:1px 4px;overflow-wrap:anywhere}\npre{padding:10px 12px;overflow-x:auto}\n.b{display:inline-block;padding:0 8px;border-radius:10px;font-size:12px;border:1px solid var(--ln);color:var(--mu)}\n.s0,.pass{color:var(--ok);border-color:var(--ok)}\n.s2,.fail{color:var(--bad);border-color:var(--bad)}\n.s3{color:var(--mg);border-color:var(--mg)}\n.c{border:1px solid var(--ln);border-radius:6px;margin:12px 0}\n.c>p{margin:0;padding:6px 12px;background:var(--cd);border-bottom:1px solid var(--ln);font-size:13px;color:var(--mu)}\n.c>div{padding:10px 12px;white-space:pre-wrap;overflow-wrap:anywhere}\n.bar{display:inline-block;height:10px;background:var(--ac);border-radius:2px;vertical-align:middle}\nform{display:grid;gap:8px;max-width:680px}\nlabel{font-size:13px;color:var(--mu)}\ninput[type=text],textarea{display:block;width:100%;margin-top:2px;padding:6px 8px;font:inherit;color:var(--fg);background:var(--bg);border:1px solid var(--ln);border-radius:6px}\ntextarea{min-height:160px}\nbutton{justify-self:start;padding:6px 16px;font:inherit;font-weight:600;color:#fff;background:var(--ok);border:0;border-radius:6px;cursor:pointer}\n.hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}\n</style>\n</head>\n<body>\n<header><a href=\""
text hd3 "\">Omega Forge</a> <span class=\"mu\">· every AIEN project, on Radicle, served from my own hardware</span></header>\n<main>\n"
text ft1 "</main>\n<footer>Generated by <code>tools/forge.om</code>, seeded Omega, from what this seed node holds on "
text ft2 ". Issues and patches are Radicle collaborative objects, signed by the people who wrote them and copied peer to peer; this page only shows them. No script, no cookie, no tracker.</footer>\n</body>\n</html>\n"
